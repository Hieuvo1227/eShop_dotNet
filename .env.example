# ============================================================
# eShop Environment Variables Example (.env.example)
# Sao chép file này thành .env để chạy môi trường cục bộ/Docker
# KHÔNG BAO GIỜ commit file .env chứa thông tin bí mật lên Git
# ============================================================

# Database Configuration
DATABASE_PROVIDER=Sqlite
# Dùng cho PostgreSQL:
# DATABASE_PROVIDER=PostgreSql
# POSTGRES_CONNECTION=Host=postgres;Port=5432;Database=eshop_db;Username=postgres;Password=YourSecureDbPassword123!

# Redis Cache
REDIS_ENABLED=false
REDIS_CONNECTION=redis:6379

# Message Broker (MassTransit)
EVENTBUS_PROVIDER=InMemory
# Dùng cho RabbitMQ:
# EVENTBUS_PROVIDER=RabbitMQ
# EVENTBUS_HOST=rabbitmq
# EVENTBUS_USER=guest
# EVENTBUS_PASS=guest

# JWT Authentication & Security (Bắt buộc phải đổi key bí mật mạnh khi chạy Production)
JWT_SECRET=Rotate_This_Super_Secret_Key_For_Production_2026_Minimum_64_Characters_Long!
JWT_ISSUER=eShop.API
JWT_AUDIENCE=eShop.Client
JWT_EXPIRY_MINUTES=120

# Development Seed Credentials (Chỉ áp dụng trong môi trường Development)
SEED_ADMIN_EMAIL=admin@eshop.com
SEED_ADMIN_PASSWORD=Admin@SecurePass2026!
SEED_USER_EMAIL=user@eshop.com
SEED_USER_PASSWORD=User@SecurePass2026!

# AI Assistant (Semantic Kernel / OpenAI)
AI_PROVIDER=OpenAI
OPENAI_API_KEY=sk-placeholder-your-openai-api-key
OPENAI_MODEL_ID=gpt-4o-mini

