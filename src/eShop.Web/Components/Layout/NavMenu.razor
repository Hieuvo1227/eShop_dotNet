@inject CartStateService CartState
@inject AuthStateService AuthState
@inject ComparisonStateService ComparisonState
@inject ShopApiClient ApiClient
@inject ToastService ToastService
@inject NavigationManager NavigationManager
@using eShop.Web.Components.Shared
@implements IDisposable

<!-- 1. Top Utility Bar (Chuẩn các sàn bán lẻ lớn) -->
<div class="top-utility-bar text-secondary py-1 border-bottom" style="background: #090d16; font-size: 0.78rem;">
    <div class="container d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div class="d-flex align-items-center gap-3">
            <span><i class="bi bi-telephone-fill text-success me-1"></i> Hotline mua hàng: <strong class="text-white">1800.6868</strong> (Miễn phí 8h-21h30)</span>
            <span class="d-none d-md-inline text-muted">•</span>
            <span class="d-none d-md-inline"><i class="bi bi-truck text-primary me-1"></i> Giao nhanh 2H nội thành</span>
        </div>
        <div class="d-flex align-items-center gap-3">
            <a href="orders" class="text-decoration-none text-secondary hover-text-white d-none d-sm-inline">
                <i class="bi bi-search me-1"></i> Tra cứu đơn hàng
            </a>
            <span class="d-none d-sm-inline text-muted">•</span>
            <span class="text-secondary"><i class="bi bi-shield-check text-warning me-1"></i> 100% Hàng chính hãng</span>
        </div>
    </div>
</div>

<!-- 2. Main Navbar (Logo, Wide Search Bar, Actions) -->
<nav class="navbar navbar-expand-lg navbar-dark navbar-glass sticky-top py-2">
    <div class="container">
        <!-- Logo eShop -->
        <a class="navbar-brand d-flex align-items-center gap-2 fw-bold text-white fs-4 me-lg-4" href="">
            <div class="rounded-circle d-flex align-items-center justify-content-center text-white shadow-sm"
                 style="width: 40px; height: 40px; background: var(--brand-gradient); font-size: 1.25rem;">
                <i class="bi bi-laptop-fill"></i>
            </div>
            <div class="d-flex flex-column lh-1">
                <span style="letter-spacing: -0.03em;">eShop<span class="text-primary">.vn</span></span>
                <span class="text-secondary fw-normal" style="font-size: 0.65rem; letter-spacing: 0.05em;">CÔNG NGHỆ CHÍNH HÃNG</span>
            </div>
        </a>

        <!-- Category Menu Button (Danh Mục) -->
        <a href="#product-catalog" class="btn btn-dark btn-sm rounded-pill px-3 py-2 border border-secondary border-opacity-50 text-white d-none d-md-flex align-items-center gap-2 me-3">
            <i class="bi bi-grid-fill text-primary"></i>
            <span class="fw-semibold small">Danh mục</span>
        </a>

        <!-- Wide Central Search Bar -->
        <div class="flex-grow-1 mx-lg-2 my-2 my-lg-0" style="max-width: 500px;">
            <form @onsubmit="HandleHeaderSearch" class="input-group">
                <span class="input-group-text bg-white border-end-0 text-muted ps-3 rounded-start-pill">
                    <i class="bi bi-search"></i>
                </span>
                <input type="text" 
                       class="form-control border-start-0 border-end-0 py-2 small" 
                       placeholder="Bạn cần tìm iPhone, S24, MacBook, phụ kiện gì?..." 
                       @bind="_navSearchTerm" />
                <button class="btn btn-primary px-3 rounded-end-pill fw-semibold small shadow-sm" 
                        type="submit"
                        style="background: var(--brand-gradient); border: none;">
                    Tìm kiếm
                </button>
            </form>
        </div>

        <!-- Mobile Toggler -->
        <button class="navbar-toggler border-0 shadow-none ms-2" type="button" @onclick="() => _isNavCollapsed = !_isNavCollapsed">
            <span class="navbar-toggler-icon"></span>
        </button>

        <!-- Navbar Content & Action Buttons -->
        <div class="collapse navbar-collapse @(_isNavCollapsed ? "" : "show")" id="navbarContent">
            <div class="d-flex align-items-center gap-2 ms-auto pt-2 pt-lg-0 flex-wrap">
                <!-- Orders Link -->
                <NavLink class="btn btn-outline-light btn-sm d-flex align-items-center gap-1 px-3 py-2 rounded-pill border-opacity-50" href="orders">
                    <i class="bi bi-receipt"></i>
                    <span class="small fw-semibold">Đơn hàng</span>
                </NavLink>

                <!-- Comparison Button with Dynamic Counter -->
                <button class="btn btn-outline-light btn-sm position-relative d-flex align-items-center gap-1 px-3 py-2 rounded-pill border-opacity-50"
                        @onclick="() => _showComparisonModal = true"
                        title="Bảng so sánh thông số kỹ thuật">
                    <i class="bi bi-arrow-left-right"></i>
                    <span class="d-none d-sm-inline fw-semibold small">So sánh</span>
                    @if (ComparisonState.Count > 0)
                    {
                        <span class="badge rounded-pill bg-warning text-dark ms-1">@ComparisonState.Count</span>
                    }
                </button>

                <!-- Admin Button (if role Admin) -->
                @if (AuthState.IsAdmin)
                {
                    <NavLink class="btn btn-warning btn-sm d-flex align-items-center gap-1 px-3 py-2 rounded-pill fw-bold text-dark shadow-sm" href="admin">
                        <i class="bi bi-speedometer2"></i>
                        <span class="small">Quản Trị</span>
                    </NavLink>
                }

                <!-- User Profile / Auth State -->
                @if (AuthState.IsAuthenticated)
                {
                    <div class="position-relative">
                        <button class="btn btn-dark btn-sm d-flex align-items-center gap-2 px-3 py-1 rounded-pill border border-secondary border-opacity-50" 
                                type="button" 
                                @onclick="() => _isUserDropdownOpen = !_isUserDropdownOpen">
                            <div class="rounded-circle d-flex align-items-center justify-content-center text-white fw-bold" 
                                 style="width: 28px; height: 28px; background: var(--brand-gradient); font-size: 0.8rem;">
                                @(AuthState.CurrentUser?.FullName?.Substring(0, 1).ToUpper() ?? "U")
                            </div>
                            <div class="text-start d-none d-sm-block lh-1">
                                <div class="small fw-semibold text-white">@AuthState.CurrentUser?.FullName</div>
                                <span class="badge px-1 py-0" style="font-size: 0.65rem; background: @(AuthState.IsAdmin ? "var(--accent-warning)" : "var(--brand-primary)");">
                                    @(AuthState.IsAdmin ? "Quản trị viên" : "Khách hàng")
                                </span>
                            </div>
                            <i class="bi bi-chevron-down small text-secondary"></i>
                        </button>

                        @if (_isUserDropdownOpen)
                        {
                            <ul class="dropdown-menu dropdown-menu-end show shadow-lg border-0 rounded-3 p-2 position-absolute" 
                                style="top: 100%; right: 0; min-width: 220px; z-index: 1050; margin-top: 8px;">
                                <li class="px-3 py-2 border-bottom">
                                    <div class="small text-muted">Tài khoản:</div>
                                    <div class="fw-bold small text-truncate">@AuthState.CurrentUser?.Email</div>
                                </li>
                                @if (AuthState.IsAdmin)
                                {
                                    <li>
                                        <a class="dropdown-item py-2 text-warning fw-semibold" href="admin" @onclick="() => _isUserDropdownOpen = false">
                                            <i class="bi bi-shield-check me-2"></i> Dashboard Quản trị
                                        </a>
                                    </li>
                                }
                                <li>
                                    <a class="dropdown-item py-2" href="orders" @onclick="() => _isUserDropdownOpen = false">
                                        <i class="bi bi-bag-check me-2"></i> Lịch sử đơn hàng
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider my-1"></li>
                                <li>
                                    <button class="dropdown-item text-danger py-2" @onclick="HandleLogout">
                                        <i class="bi bi-box-arrow-right me-2"></i> Đăng xuất
                                    </button>
                                </li>
                            </ul>
                        }
                    </div>
                }
                else
                {
                    <button class="btn btn-outline-light btn-sm px-3 py-2 rounded-pill fw-semibold d-flex align-items-center gap-1"
                            @onclick="() => _showAuthModal = true">
                        <i class="bi bi-person-circle"></i>
                        <span>Đăng Nhập</span>
                    </button>
                }

                <!-- Cart Button -->
                <a href="cart" class="btn btn-primary btn-sm position-relative d-flex align-items-center gap-2 px-3 py-2 rounded-pill shadow-sm"
                   style="background: var(--brand-gradient); border: none;">
                    <i class="bi bi-cart3 fs-6"></i>
                    <span class="d-none d-sm-inline fw-semibold small">Giỏ hàng</span>
                    @if (CartState.TotalItemCount > 0)
                    {
                        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger badge-pulse">
                            @CartState.TotalItemCount
                            <span class="visually-hidden">món trong giỏ</span>
                        </span>
                    }
                </a>
            </div>
        </div>
    </div>
</nav>

<!-- 3. Category Quick Bar (Dải Ngành Hàng Ngang Chuẩn E-Commerce) -->
<div class="bg-dark py-2 border-bottom border-secondary border-opacity-25 d-none d-md-block" style="background: #111827 !important;">
    <div class="container d-flex align-items-center justify-content-between overflow-auto text-nowrap gap-3 small">
        <div class="d-flex align-items-center gap-3">
            <a href="#product-catalog" class="text-decoration-none text-light hover-primary fw-medium">
                <i class="bi bi-phone text-primary me-1"></i> Điện Thoại
            </a>
            <span class="text-secondary opacity-50">|</span>
            <a href="#product-catalog" class="text-decoration-none text-light hover-primary fw-medium">
                <i class="bi bi-laptop text-info me-1"></i> Laptop & MacBook
            </a>
            <span class="text-secondary opacity-50">|</span>
            <a href="#product-catalog" class="text-decoration-none text-light hover-primary fw-medium">
                <i class="bi bi-headphones text-warning me-1"></i> Âm Thanh & Tai Nghe
            </a>
            <span class="text-secondary opacity-50">|</span>
            <a href="#product-catalog" class="text-decoration-none text-light hover-primary fw-medium">
                <i class="bi bi-mouse text-success me-1"></i> Bàn Phím & Chuột
            </a>
        </div>

        <div class="d-flex align-items-center gap-3">
            <a href="#product-catalog" class="text-decoration-none text-warning fw-bold">
                <i class="bi bi-lightning-charge-fill me-1"></i> Flash Sale
            </a>
            <span class="text-secondary opacity-50">|</span>
            <a href="#product-catalog" class="text-decoration-none text-light hover-primary">
                <i class="bi bi-arrow-repeat text-danger me-1"></i> Thu Cũ Đổi Mới
            </a>
            <span class="text-secondary opacity-50">|</span>
            <a href="#product-catalog" class="text-decoration-none text-light hover-primary">
                <i class="bi bi-credit-card text-success me-1"></i> Trả Góp 0%
            </a>
        </div>
    </div>
</div>

<!-- Auth Modal -->
<AuthModal @bind-IsOpen="_showAuthModal" />

<!-- Comparison Modal -->
<ComparisonModal @bind-IsOpen="_showComparisonModal" />

@code {
    private bool _showAuthModal = false;
    private bool _showComparisonModal = false;
    private bool _isUserDropdownOpen = false;
    private bool _isNavCollapsed = true;
    private string _navSearchTerm = "";

    protected override async Task OnInitializedAsync()
    {
        CartState.OnChange += StateHasChanged;
        AuthState.OnChange += HandleAuthStateChanged;
        ComparisonState.OnChange += StateHasChanged;

        await ApiClient.GetBasketAsync(AuthState.CurrentBuyerId);
    }

    private void HandleHeaderSearch()
    {
        if (!string.IsNullOrWhiteSpace(_navSearchTerm))
        {
            NavigationManager.NavigateTo($"/?search={Uri.EscapeDataString(_navSearchTerm.Trim())}#product-catalog", forceLoad: false);
        }
    }

    private async void HandleAuthStateChanged()
    {
        _isUserDropdownOpen = false;
        await ApiClient.GetBasketAsync(AuthState.CurrentBuyerId);
        StateHasChanged();
    }

    private void HandleLogout()
    {
        _isUserDropdownOpen = false;
        AuthState.Logout();
        ToastService.ShowInfo("Bạn đã đăng xuất khỏi hệ thống.", "Tạm biệt");
    }

    public void Dispose()
    {
        CartState.OnChange -= StateHasChanged;
        AuthState.OnChange -= HandleAuthStateChanged;
        ComparisonState.OnChange -= StateHasChanged;
    }
}
