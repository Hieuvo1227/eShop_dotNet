@inject CartStateService CartState
@inject AuthStateService AuthState
@inject ShopApiClient ApiClient
@inject ToastService ToastService
@using eShop.Web.Components.Shared
@implements IDisposable

<nav class="navbar navbar-expand-lg navbar-dark navbar-glass sticky-top py-2">
    <div class="container">
        <!-- Logo eShop -->
        <a class="navbar-brand d-flex align-items-center gap-2 fw-bold text-white fs-4" href="">
            <span class="badge rounded-pill px-2 py-1 fs-6" style="background: var(--brand-gradient);">.NET 8</span>
            <span style="letter-spacing: -0.03em;">eShop<span class="text-primary">.Pro</span></span>
        </a>

        <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarContent">
            <!-- Nav Links -->
            <ul class="navbar-nav me-auto mb-2 mb-lg-0 fs-6 gap-1">
                <li class="nav-item">
                    <NavLink class="nav-link px-3 rounded-pill" href="" Match="NavLinkMatch.All">
                        <i class="bi bi-grid-fill me-1"></i> Sản phẩm
                    </NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link px-3 rounded-pill" href="orders">
                        <i class="bi bi-receipt me-1"></i> Đơn hàng
                    </NavLink>
                </li>
                @if (AuthState.IsAdmin)
                {
                    <li class="nav-item">
                        <NavLink class="nav-link px-3 rounded-pill text-warning fw-semibold" href="admin">
                            <i class="bi bi-speedometer2 me-1"></i> Quản Trị Admin
                        </NavLink>
                    </li>
                }
            </ul>

            <!-- Right Action Bar -->
            <div class="d-flex align-items-center gap-3">
                <!-- User Profile / Auth State -->
                @if (AuthState.IsAuthenticated)
                {
                    <div class="dropdown">
                        <button class="btn btn-dark d-flex align-items-center gap-2 px-3 py-1 rounded-pill border border-secondary border-opacity-50 dropdown-toggle" 
                                type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <div class="rounded-circle d-flex align-items-center justify-content-center text-white fw-bold" 
                                 style="width: 28px; height: 28px; background: var(--brand-gradient); font-size: 0.8rem;">
                                @(AuthState.CurrentUser?.FullName?.Substring(0, 1).ToUpper() ?? "U")
                            </div>
                            <div class="text-start d-none d-sm-block lh-1">
                                <div class="small fw-semibold text-white">@AuthState.CurrentUser?.FullName</div>
                                <span class="badge px-1 py-0" style="font-size: 0.65rem; background: @(AuthState.IsAdmin ? "var(--accent-warning)" : "var(--brand-primary)");">
                                    @AuthState.CurrentUser?.Role
                                </span>
                            </div>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 rounded-3 p-2">
                            <li class="px-3 py-2 border-bottom">
                                <div class="small text-muted">Đăng nhập với email:</div>
                                <div class="fw-bold small text-truncate" style="max-width: 200px;">@AuthState.CurrentUser?.Email</div>
                            </li>
                            @if (AuthState.IsAdmin)
                            {
                                <li>
                                    <a class="dropdown-item py-2 text-warning fw-semibold" href="admin">
                                        <i class="bi bi-shield-check me-2"></i> Dashboard Quản trị
                                    </a>
                                </li>
                            }
                            <li>
                                <a class="dropdown-item py-2" href="orders">
                                    <i class="bi bi-bag-check me-2"></i> Lịch sử đơn hàng
                                </a>
                            </li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <button class="dropdown-item text-danger py-2" @onclick="HandleLogout">
                                    <i class="bi bi-box-arrow-right me-2"></i> Đăng xuất
                                </button>
                            </li>
                        </ul>
                    </div>
                }
                else
                {
                    <button class="btn btn-outline-light btn-sm px-3 py-2 rounded-pill fw-semibold d-flex align-items-center gap-1"
                            @onclick="() => _showAuthModal = true">
                        <i class="bi bi-person-circle"></i>
                        <span>Đăng Nhập</span>
                    </button>
                }

                <!-- Cart Button -->
                <a href="cart" class="btn btn-outline-light position-relative d-flex align-items-center gap-2 px-3 py-2 rounded-pill border-opacity-50">
                    <i class="bi bi-cart3 fs-5"></i>
                    <span class="d-none d-sm-inline fw-semibold">Giỏ hàng</span>
                    @if (CartState.TotalItemCount > 0)
                    {
                        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger badge-pulse">
                            @CartState.TotalItemCount
                            <span class="visually-hidden">sản phẩm trong giỏ</span>
                        </span>
                    }
                </a>
            </div>
        </div>
    </div>
</nav>

<!-- Auth Modal component -->
<AuthModal @bind-IsOpen="_showAuthModal" />

@code {
    private bool _showAuthModal = false;

    protected override async Task OnInitializedAsync()
    {
        CartState.OnChange += StateHasChanged;
        AuthState.OnChange += HandleAuthStateChanged;

        await ApiClient.GetBasketAsync(AuthState.CurrentBuyerId);
    }

    private async void HandleAuthStateChanged()
    {
        // Khi thay đổi tài khoản, nạp lại giỏ hàng của tài khoản đó
        await ApiClient.GetBasketAsync(AuthState.CurrentBuyerId);
        StateHasChanged();
    }

    private void HandleLogout()
    {
        AuthState.Logout();
        ToastService.ShowInfo("Bạn đã đăng xuất khỏi hệ thống.", "Tạm biệt");
    }

    public void Dispose()
    {
        CartState.OnChange -= StateHasChanged;
        AuthState.OnChange -= HandleAuthStateChanged;
    }
}
