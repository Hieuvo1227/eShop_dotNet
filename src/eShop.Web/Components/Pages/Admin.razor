<!-- Modal Xác Nhận Xóa Sản Phẩm -->
@if (_showDeleteModal && _productToDelete != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(15, 23, 42, 0.6); backdrop-filter: blur(8px);">
        <div class="modal-dialog modal-dialog-centered" style="max-width: 440px;">
            <div class="modal-content border-0 rounded-4 shadow-lg overflow-hidden p-4 text-center">
                <div class="d-inline-flex p-3 rounded-circle mb-3 mx-auto text-danger" style="background: rgba(239, 68, 68, 0.1);">
                    <i class="bi bi-trash3-fill fs-3"></i>
                </div>
                <h5 class="fw-bold text-dark mb-2">Xóa Sản Phẩm?</h5>
                <p class="text-secondary small mb-4">
                    Bạn có chắc chắn muốn xóa sản phẩm <strong>@_productToDelete.Name</strong> (SKU: @_productToDelete.SKU)? Hành động này không thể hoàn tác.
                </p>
                <div class="d-flex justify-content-center gap-2">
                    <button class="btn btn-outline-secondary rounded-pill px-4" @onclick="() => _showDeleteModal = false">
                        Hủy
                    </button>
                    <button class="btn btn-danger rounded-pill px-4" @onclick="DeleteProductAsync">
                        Xác Nhận Xóa
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private string _activeTab = "overview";
    private AdminMetricsDto? _metrics;
    private PaginatedList<ProductDto>? _products;
    private List<OrderDto>? _allOrders;
    private string _orderStatusFilter = "";

    private bool _isLoading = true;
    private bool _showAddProductModal = false;
    private bool _showEditProductModal = false;
    private bool _showDeleteModal = false;
    private bool _isSavingProduct = false;

    private ProductDto? _productToDelete;

    public class ProductFormModel
    {
        public int Id { get; set; }
        public string Name { get; set; } = "";
        public string Sku { get; set; } = "";
        public decimal Price { get; set; } = 28990000;
        public int StockQuantity { get; set; } = 30;
        public int BrandId { get; set; } = 1;
        public int CategoryId { get; set; } = 1;
        public string PictureUrl { get; set; } = "https://images.unsplash.com/photo-1544244015-0df4b3ffc6b0?w=500";
        public string Description { get; set; } = "Thiết kế siêu mỏng nhẹ, chip M4 bứt phá mọi giới hạn xử lý.";
    }

    private ProductFormModel _newProduct = new();
    private ProductFormModel? _editingProduct;

    public class UserManagementDto
    {
        public string Email { get; set; } = "";
        public string FullName { get; set; } = "";
        public string Role { get; set; } = "Customer";
        public bool IsActive { get; set; } = true;
        public DateTime CreatedAt { get; set; } = DateTime.UtcNow.AddDays(-15);
    }

    private List<UserManagementDto> _managedUsers = new()
    {
        new() { Email = "admin@eshop.com", FullName = "Quản Trị Viên Hệ Thống", Role = "Admin", IsActive = true, CreatedAt = DateTime.UtcNow.AddDays(-60) },
        new() { Email = "sales@eshop.com", FullName = "Nhân Viên Kinh Doanh", Role = "Sales", IsActive = true, CreatedAt = DateTime.UtcNow.AddDays(-30) },
        new() { Email = "user@eshop.com", FullName = "Khách Hàng Thử Nghiệm", Role = "Customer", IsActive = true, CreatedAt = DateTime.UtcNow.AddDays(-10) }
    };

    private void ToggleUserRole(UserManagementDto user)
    {
        user.Role = user.Role switch
        {
            "Customer" => "Sales",
            "Sales" => "Admin",
            "Admin" => "Customer",
            _ => "Customer"
        };
        ToastService.ShowSuccess($"Đã đổi vai trò của {user.Email} thành {user.Role}!", "Phân quyền RBAC");
    }

    private void ToggleUserStatus(UserManagementDto user)
    {
        user.IsActive = !user.IsActive;
        if (user.IsActive)
            ToastService.ShowSuccess($"Đã mở khóa tài khoản {user.Email}!", "Quản trị người dùng");
        else
            ToastService.ShowWarning($"Đã tạm khóa tài khoản {user.Email}!", "Quản trị người dùng");
    }

    private void AddNewUserMock()
    {
        var nextId = _managedUsers.Count + 1;
        _managedUsers.Add(new UserManagementDto
        {
            Email = $"khachhang{nextId}@gmail.com",
            FullName = $"Khách Hàng Mới #{nextId}",
            Role = "Customer",
            IsActive = true,
            CreatedAt = DateTime.UtcNow
        });
        ToastService.ShowSuccess($"Đã tạo tài khoản khách hàng mới #{nextId} thành công!", "Tạo tài khoản");
    }

    protected override async Task OnInitializedAsync()
    {
        if (AuthState.IsAdmin)
        {
            await ReloadAllAsync();
        }
    }

    private async Task ReloadAllAsync()
    {
        _isLoading = true;
        try
        {
            await Task.WhenAll(LoadMetricsAsync(), LoadProductsAsync(), LoadAllOrdersAsync());
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task LoadMetricsAsync()
    {
        try
        {
            _metrics = await ApiClient.GetAdminMetricsAsync();
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Lỗi tải chỉ số Admin: {ex.Message}");
        }
    }

    private async Task LoadProductsAsync()
    {
        try
        {
            _products = await ApiClient.GetProductsAsync(pageIndex: 1, pageSize: 50);
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Lỗi nạp sản phẩm: {ex.Message}");
        }
    }

    private async Task LoadAllOrdersAsync()
    {
        try
        {
            _allOrders = await ApiClient.GetAllOrdersAsync(_orderStatusFilter);
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Lỗi nạp đơn hàng: {ex.Message}");
        }
    }

    private async Task AdjustStockAsync(int productId, int adjustment)
    {
        try
        {
            var success = await ApiClient.UpdateProductStockAsync(productId, adjustment);
            if (success)
            {
                ToastService.ShowSuccess($"Đã điều chỉnh kho hàng sản phẩm #{productId} ({adjustment:+0;-0}) thành công!", "Kho hàng");
                await LoadProductsAsync();
                await LoadMetricsAsync();
            }
            else
            {
                ToastService.ShowError("Không thể cập nhật tồn kho.");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError(ex.Message);
        }
    }

    private async Task UpdateOrderStatusAsync(int orderId, string newStatus)
    {
        try
        {
            var updated = await ApiClient.UpdateOrderStatusAsync(orderId, newStatus);
            if (updated != null)
            {
                ToastService.ShowSuccess($"Đơn hàng #{orderId} đã được chuyển sang trạng thái '{newStatus}'!", "Cập nhật đơn hàng");
                await LoadAllOrdersAsync();
                await LoadMetricsAsync();
            }
            else
            {
                ToastService.ShowError("Không thể cập nhật trạng thái đơn hàng.");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError(ex.Message);
        }
    }

    private void OpenAddProductModal()
    {
        _newProduct = new ProductFormModel();
        _showAddProductModal = true;
    }

    private void OpenEditProductModal(ProductDto p)
    {
        _editingProduct = new ProductFormModel
        {
            Id = p.Id,
            Name = p.Name,
            Sku = p.SKU,
            Price = p.Price,
            StockQuantity = p.StockQuantity,
            BrandId = p.BrandId,
            CategoryId = p.CategoryId,
            PictureUrl = p.PictureUrl ?? "",
            Description = p.Description ?? ""
        };
        _showEditProductModal = true;
    }

    private void ConfirmDeleteProduct(ProductDto p)
    {
        _productToDelete = p;
        _showDeleteModal = true;
    }

    private async Task CreateProductAsync()
    {
        _isSavingProduct = true;
        try
        {
            var command = new CreateProductCommand
            {
                Name = _newProduct.Name,
                SKU = _newProduct.Sku,
                Price = _newProduct.Price,
                StockQuantity = _newProduct.StockQuantity,
                BrandId = _newProduct.BrandId,
                CategoryId = _newProduct.CategoryId,
                PictureUrl = _newProduct.PictureUrl,
                Description = _newProduct.Description
            };

            var newId = await ApiClient.CreateProductAsync(command);

            if (newId.HasValue)
            {
                ToastService.ShowSuccess($"Sản phẩm mới '{_newProduct.Name}' đã được tạo với Id #{newId.Value}!", "Thành công");
                _showAddProductModal = false;
                await LoadProductsAsync();
                await LoadMetricsAsync();
            }
            else
            {
                ToastService.ShowError("Tạo sản phẩm thất bại. Vui lòng kiểm tra quyền Admin.");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError(ex.Message);
        }
        finally
        {
            _isSavingProduct = false;
        }
    }

    private async Task SaveEditProductAsync()
    {
        if (_editingProduct == null) return;

        _isSavingProduct = true;
        try
        {
            var command = new UpdateProductCommand
            {
                Id = _editingProduct.Id,
                Name = _editingProduct.Name,
                SKU = _editingProduct.Sku,
                Price = _editingProduct.Price,
                StockQuantity = _editingProduct.StockQuantity,
                BrandId = _editingProduct.BrandId,
                CategoryId = _editingProduct.CategoryId,
                PictureUrl = _editingProduct.PictureUrl,
                Description = _editingProduct.Description
            };

            var success = await ApiClient.UpdateProductAsync(command);
            if (success)
            {
                ToastService.ShowSuccess($"Đã cập nhật thông tin sản phẩm #{_editingProduct.Id} thành công!", "Cập nhật sản phẩm");
                _showEditProductModal = false;
                await LoadProductsAsync();
            }
            else
            {
                ToastService.ShowError("Cập nhật sản phẩm thất bại.");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError(ex.Message);
        }
        finally
        {
            _isSavingProduct = false;
        }
    }

    private async Task DeleteProductAsync()
    {
        if (_productToDelete == null) return;

        try
        {
            var success = await ApiClient.DeleteProductAsync(_productToDelete.Id);
            if (success)
            {
                ToastService.ShowSuccess($"Đã xóa sản phẩm #{_productToDelete.Id} khỏi hệ thống!", "Xóa sản phẩm");
                _showDeleteModal = false;
                _productToDelete = null;
                await LoadProductsAsync();
                await LoadMetricsAsync();
            }
            else
            {
                ToastService.ShowError("Không thể xóa sản phẩm này.");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError(ex.Message);
        }
    }

    private string GetStatusBadgeClass(string status) => status?.ToLowerInvariant() switch
    {
        "submitted" => "bg-primary-subtle text-primary border border-primary border-opacity-25",
        "awaitingpayment" => "bg-warning-subtle text-warning border border-warning border-opacity-25",
        "paid" => "bg-success-subtle text-success border border-success border-opacity-25",
        "shipped" => "bg-info-subtle text-info border border-info border-opacity-25",
        "completed" => "bg-success text-white",
        "cancelled" => "bg-danger-subtle text-danger border border-danger border-opacity-25",
        _ => "bg-secondary-subtle text-secondary"
    };
}
