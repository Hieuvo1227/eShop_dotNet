@page "/"
@inject ShopApiClient ApiClient
@inject CartStateService CartState

<PageTitle>eShop - Sàn Thương Mại Điện Tử Hiện Đại</PageTitle>

<!-- Hero Banner -->
<div class="p-4 p-md-5 mb-4 rounded-4 text-white bg-dark shadow-sm position-relative overflow-hidden" 
     style="background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);">
    <div class="col-lg-8 px-0 position-relative z-1">
        <span class="badge bg-warning text-dark mb-2 px-3 py-2 rounded-pill fw-bold">
            <i class="bi bi-robot"></i> Tích hợp AI Semantic Kernel & Redis Cart
        </span>
        <h1 class="display-5 fw-bold mb-3">Công Nghệ Đỉnh Cao, Mua Sắm Thông Minh</h1>
        <p class="lead my-3 opacity-90">
            Khám phá điện thoại, laptop, phụ kiện chính hãng với hệ sinh thái phân tán: 
            Clean Architecture, PostgreSQL, Redis và Trợ lý AI tư vấn tự động!
        </p>
    </div>
</div>

<!-- Search & Filters Toolbar -->
<div class="card border-0 shadow-sm rounded-4 p-3 mb-4">
    <div class="row g-3 align-items-center">
        <!-- Search bar -->
        <div class="col-md-5">
            <div class="input-group">
                <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                <input type="text" class="form-control border-start-0" 
                       placeholder="Tìm kiếm sản phẩm theo tên..." 
                       @bind="_searchTerm" 
                       @bind:event="oninput" 
                       @onkeyup="OnSearchKeyUp" />
            </div>
        </div>

        <!-- Filter Brand -->
        <div class="col-md-3">
            <select class="form-select" @onchange="OnBrandChanged">
                <option value="">Tất cả Thương hiệu</option>
                @if (_brands != null)
                {
                    @foreach (var brand in _brands)
                    {
                        <option value="@brand.Id">@brand.Name</option>
                    }
                }
            </select>
        </div>

        <!-- Filter Category -->
        <div class="col-md-3">
            <select class="form-select" @onchange="OnCategoryChanged">
                <option value="">Tất cả Ngành hàng</option>
                @if (_categories != null)
                {
                    @foreach (var cat in _categories)
                    {
                        <option value="@cat.Id">@cat.Name</option>
                    }
                }
            </select>
        </div>

        <!-- Reset Button -->
        <div class="col-md-1 text-end">
            <button class="btn btn-outline-secondary w-100" @onclick="ResetFilters" title="Đặt lại bộ lọc">
                <i class="bi bi-arrow-counterclockwise"></i>
            </button>
        </div>
    </div>
</div>

<!-- Product Grid -->
@if (_isLoading)
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;"></div>
        <div class="mt-3 text-muted">Đang tải danh mục sản phẩm từ eShop.API...</div>
    </div>
}
else if (_products == null || !_products.Items.Any())
{
    <div class="text-center py-5 bg-white rounded-4 shadow-sm">
        <div class="fs-1 text-muted">📦</div>
        <h4 class="mt-2 text-secondary">Không tìm thấy sản phẩm nào!</h4>
        <p class="text-muted">Vui lòng thử từ khóa khác hoặc bấm đặt lại bộ lọc.</p>
        <button class="btn btn-primary rounded-pill px-4" @onclick="ResetFilters">Xem tất cả sản phẩm</button>
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4 mb-4">
        @foreach (var product in _products.Items)
        {
            <div class="col">
                <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden product-card transition-all">
                    <!-- Image -->
                    <div class="position-relative overflow-hidden bg-light" style="height: 220px;">
                        <img src="@product.PictureUrl" alt="@product.Name" 
                             class="w-100 h-100 object-fit-cover product-img" />
                        <span class="position-absolute top-0 start-0 m-2 badge bg-dark bg-opacity-75 rounded-pill">
                            @product.BrandName
                        </span>
                        @if (product.StockQuantity <= 0)
                        {
                            <span class="position-absolute top-0 end-0 m-2 badge bg-danger rounded-pill">Hết hàng</span>
                        }
                        else
                        {
                            <span class="position-absolute top-0 end-0 m-2 badge bg-success rounded-pill">Còn @product.StockQuantity</span>
                        }
                    </div>

                    <!-- Card Body -->
                    <div class="card-body d-flex flex-column p-3">
                        <small class="text-muted mb-1">@product.CategoryName</small>
                        <h6 class="card-title fw-bold mb-2 text-truncate-2" title="@product.Name" style="height: 2.6rem;">
                            @product.Name
                        </h6>
                        <p class="card-text text-muted small text-truncate-2 mb-3" style="height: 2.4rem;">
                            @product.Description
                        </p>

                        <div class="mt-auto d-flex align-items-center justify-content-between pt-2 border-top">
                            <div>
                                <span class="fs-5 fw-bold text-primary">@product.Price.ToString("N0")</span>
                                <small class="text-muted">đ</small>
                            </div>

                            <button class="btn btn-primary rounded-pill px-3 py-1 btn-sm d-flex align-items-center gap-1"
                                    disabled="@(product.StockQuantity <= 0)"
                                    @onclick="() => AddToCart(product.Id)">
                                <i class="bi bi-cart-plus"></i>
                                <span>Mua</span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Pagination -->
    @if (_products.TotalPages > 1)
    {
        <div class="d-flex justify-content-center gap-2 mt-4">
            <button class="btn btn-outline-primary rounded-pill px-3" 
                    disabled="@(!_products.HasPreviousPage)" 
                    @onclick="() => ChangePage(_pageIndex - 1)">
                ← Trang trước
            </button>
            <span class="align-self-center px-3 text-muted">
                Trang <strong>@_products.PageIndex</strong> / @_products.TotalPages
            </span>
            <button class="btn btn-outline-primary rounded-pill px-3" 
                    disabled="@(!_products.HasNextPage)" 
                    @onclick="() => ChangePage(_pageIndex + 1)">
                Trang tiếp →
            </button>
        </div>
    }
}

<style>
    .product-card {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .product-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 10px 20px rgba(0,0,0,0.08) !important;
    }
    .text-truncate-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
</style>

@code {
    private PaginatedList<ProductDto>? _products;
    private List<BrandDto>? _brands;
    private List<CategoryDto>? _categories;

    private bool _isLoading = true;
    private int _pageIndex = 1;
    private int _pageSize = 8;
    private int? _selectedBrandId;
    private int? _selectedCategoryId;
    private string _searchTerm = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadMetadataAsync();
        await LoadProductsAsync();
    }

    private async Task LoadMetadataAsync()
    {
        _brands = await ApiClient.GetBrandsAsync();
        _categories = await ApiClient.GetCategoriesAsync();
    }

    private async Task LoadProductsAsync()
    {
        _isLoading = true;
        try
        {
            _products = await ApiClient.GetProductsAsync(
                _pageIndex, 
                _pageSize, 
                _selectedBrandId, 
                _selectedCategoryId, 
                _searchTerm);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task OnSearchKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            _pageIndex = 1;
            await LoadProductsAsync();
        }
    }

    private async Task OnBrandChanged(ChangeEventArgs e)
    {
        _selectedBrandId = int.TryParse(e.Value?.ToString(), out var id) && id > 0 ? id : null;
        _pageIndex = 1;
        await LoadProductsAsync();
    }

    private async Task OnCategoryChanged(ChangeEventArgs e)
    {
        _selectedCategoryId = int.TryParse(e.Value?.ToString(), out var id) && id > 0 ? id : null;
        _pageIndex = 1;
        await LoadProductsAsync();
    }

    private async Task ResetFilters()
    {
        _searchTerm = string.Empty;
        _selectedBrandId = null;
        _selectedCategoryId = null;
        _pageIndex = 1;
        await LoadProductsAsync();
    }

    private async Task ChangePage(int newPage)
    {
        _pageIndex = newPage;
        await LoadProductsAsync();
    }

    private async Task AddToCart(int productId)
    {
        await ApiClient.AddItemToBasketAsync(CartState.BuyerId, productId, 1);
    }
}
