@page "/"
@inject ShopApiClient ApiClient
@inject CartStateService CartState
@inject AuthStateService AuthState
@inject ComparisonStateService ComparisonState
@inject ToastService ToastService
@inject NavigationManager NavigationManager
@using eShop.Web.Services
@implements IDisposable

<PageTitle>eShop • Siêu thị thiết bị công nghệ chính hãng</PageTitle>

<!-- 1. Standardized Commercial Retail Hero Section (Light / Bright Theme) -->
<section class="hero-retail-section py-4 mb-4 border-bottom" style="background: #f8fafc; border-color: #e2e8f0 !important; color: #0f172a;">
    <div class="container">
        <!-- 3-Column Bento Hero Grid -->
        <div class="row g-3">
            <!-- Col Left: Category Menu Sidebar (Chuẩn sàn công nghệ) -->
            <div class="col-lg-3 d-none d-lg-block">
                <div class="card h-100 border rounded-4 shadow-sm p-3 text-dark bg-white" style="border-color: #e2e8f0 !important;">
                    <div class="fw-bold small text-muted text-uppercase mb-2 pb-2 border-bottom d-flex align-items-center gap-2">
                        <i class="bi bi-list-ul text-primary fs-6"></i>
                        <span>Danh Mục Thiết Bị</span>
                    </div>

                    <div class="d-flex flex-column gap-1 small">
                        <button class="btn btn-light text-start border-0 rounded-3 py-2 px-2 d-flex align-items-center justify-content-between @(!_selectedCategoryId.HasValue ? "bg-primary-subtle text-primary fw-bold" : "")"
                                @onclick="() => FilterByCategory(null)">
                            <div class="d-flex align-items-center gap-2">
                                <i class="bi bi-grid-fill text-primary"></i>
                                <span>Tất cả thiết bị</span>
                            </div>
                            <i class="bi bi-chevron-right small text-muted"></i>
                        </button>

                        @if (_categories != null)
                        {
                            @foreach (var cat in _categories)
                            {
                                var isSelected = _selectedCategoryId == cat.Id;
                                var iconClass = cat.Name.Contains("Smart") || cat.Name.Contains("thoại") ? "bi-phone text-primary" :
                                                cat.Name.Contains("Lap") || cat.Name.Contains("máy") ? "bi-laptop text-info" :
                                                cat.Name.Contains("Âm") || cat.Name.Contains("nghe") ? "bi-headphones text-warning" : "bi-mouse text-success";
                                <button class="btn btn-light text-start border-0 rounded-3 py-2 px-2 d-flex align-items-center justify-content-between @(isSelected ? "bg-primary-subtle text-primary fw-bold" : "")"
                                        @onclick="() => FilterByCategory(cat.Id)">
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="bi @iconClass"></i>
                                        <span>@cat.Name</span>
                                    </div>
                                    <i class="bi bi-chevron-right small text-muted"></i>
                                </button>
                            }
                        }

                        <hr class="my-1 border-light" />

                        <a href="#product-catalog" class="btn btn-light text-start border-0 rounded-3 py-2 px-2 d-flex align-items-center justify-content-between text-danger fw-semibold">
                            <div class="d-flex align-items-center gap-2">
                                <i class="bi bi-lightning-charge-fill"></i>
                                <span>Siêu sale Flash Sale</span>
                            </div>
                            <span class="badge bg-danger rounded-pill">-35%</span>
                        </a>

                        <a href="#product-catalog" class="btn btn-light text-start border-0 rounded-3 py-2 px-2 d-flex align-items-center justify-content-between text-success">
                            <div class="d-flex align-items-center gap-2">
                                <i class="bi bi-credit-card-fill"></i>
                                <span>Trả góp 0% online</span>
                            </div>
                            <i class="bi bi-chevron-right small text-muted"></i>
                        </a>
                    </div>
                </div>
            </div>

            <!-- Col Center: Main Campaign Carousel Banner Slider (Sáng, Tinh tế, Hiện đại) -->
            <div class="col-lg-6 col-md-8">
                <div class="card h-100 border rounded-4 shadow-sm overflow-hidden position-relative" style="min-height: 380px; border-color: #e2e8f0 !important; background: #ffffff;">
                    <!-- Active Slide Content -->
                    @if (_currentSlide == 0)
                    {
                        <div class="position-absolute top-0 end-0 h-100 w-100" style="background: url('https://images.unsplash.com/photo-1695048133142-1a20484d2569?w=900') right center/contain no-repeat; opacity: 0.22;"></div>
                        <div class="card-body p-4 p-lg-5 d-flex flex-column justify-content-between position-relative z-1" style="background: linear-gradient(135deg, rgba(253, 251, 247, 0.95) 0%, rgba(245, 239, 230, 0.9) 100%);">
                            <div>
                                <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-3 py-2 rounded-pill fw-bold mb-3 shadow-xs">
                                    <i class="bi bi-stars text-warning"></i> FLAGSHIP MỚI NHẤT
                                </span>
                                <h2 class="display-6 fw-bold mb-2 font-heading text-dark">iPhone 15 Pro Max</h2>
                                <p class="text-secondary small mb-3 leading-relaxed" style="max-width: 420px;">
                                    Khung Titan siêu bền • Chip Apple A17 Pro 3nm • Camera tiềm vọng 5x đỉnh cao.
                                </p>
                                <div class="d-flex align-items-baseline gap-2 mb-4">
                                    <span class="fs-4 fw-bold text-danger font-heading">29.990.000 ₫</span>
                                    <span class="text-muted text-decoration-line-through small">34.990.000 ₫</span>
                                </div>
                            </div>
                            <div class="d-flex flex-wrap gap-2">
                                <a href="product/1" class="btn btn-primary rounded-pill px-4 py-2 fw-semibold shadow-sm" style="background: var(--brand-gradient); border: none;">
                                    <i class="bi bi-cart3 me-1"></i> Khám Phá Ngay
                                </a>
                                <button class="btn btn-outline-dark rounded-pill px-3 py-2 fw-semibold" onclick="document.querySelector('.ai-copilot-trigger')?.click()">
                                    <i class="bi bi-robot text-primary me-1"></i> Hỏi AI Tư Vấn
                                </button>
                            </div>
                        </div>
                    }
                    else if (_currentSlide == 1)
                    {
                        <div class="position-absolute top-0 end-0 h-100 w-100" style="background: url('https://images.unsplash.com/photo-1610945265064-0e34e5519bbf?w=900') right center/contain no-repeat; opacity: 0.22;"></div>
                        <div class="card-body p-4 p-lg-5 d-flex flex-column justify-content-between position-relative z-1" style="background: linear-gradient(135deg, rgba(240, 247, 255, 0.95) 0%, rgba(224, 239, 254, 0.9) 100%);">
                            <div>
                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2 rounded-pill fw-bold mb-3 shadow-xs">
                                    <i class="bi bi-cpu-fill"></i> QUYỀN NĂNG GALAXY AI
                                </span>
                                <h2 class="display-6 fw-bold mb-2 font-heading text-dark">Samsung Galaxy S24 Ultra</h2>
                                <p class="text-secondary small mb-3 leading-relaxed" style="max-width: 420px;">
                                    Camera 200MP siêu zoom • Bút S-Pen quyền năng • Khung viền Titan sang trọng.
                                </p>
                                <div class="d-flex align-items-baseline gap-2 mb-4">
                                    <span class="fs-4 fw-bold text-danger font-heading">28.490.000 ₫</span>
                                    <span class="text-muted text-decoration-line-through small">33.990.000 ₫</span>
                                </div>
                            </div>
                            <div class="d-flex flex-wrap gap-2">
                                <a href="product/2" class="btn btn-primary rounded-pill px-4 py-2 fw-bold shadow-sm" style="background: var(--brand-gradient); border: none;">
                                    <i class="bi bi-cart3 me-1"></i> Mua Ngay
                                </a>
                                <button class="btn btn-outline-dark rounded-pill px-3 py-2 fw-semibold" onclick="document.querySelector('.ai-copilot-trigger')?.click()">
                                    <i class="bi bi-robot text-primary me-1"></i> So Sánh Với iPhone
                                </button>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="position-absolute top-0 end-0 h-100 w-100" style="background: url('https://images.unsplash.com/photo-1517336714731-489689fd1ca8?w=900') right center/contain no-repeat; opacity: 0.22;"></div>
                        <div class="card-body p-4 p-lg-5 d-flex flex-column justify-content-between position-relative z-1" style="background: linear-gradient(135deg, rgba(248, 250, 252, 0.95) 0%, rgba(241, 245, 249, 0.9) 100%);">
                            <div>
                                <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 rounded-pill fw-bold mb-3 shadow-xs">
                                    <i class="bi bi-laptop"></i> HIỆU NĂNG ĐỒ HỌA ĐỈNH CAO
                                </span>
                                <h2 class="display-6 fw-bold mb-2 font-heading text-dark">MacBook Pro 14 M3 Pro</h2>
                                <p class="text-secondary small mb-3 leading-relaxed" style="max-width: 420px;">
                                    Chip Apple M3 Pro 11-core • 18GB RAM Unified • Màn hình Liquid Retina XDR 120Hz.
                                </p>
                                <div class="d-flex align-items-baseline gap-2 mb-4">
                                    <span class="fs-4 fw-bold text-danger font-heading">49.990.000 ₫</span>
                                    <span class="text-muted small ms-2">Trả góp 0% chỉ từ 4.165.000₫/tháng</span>
                                </div>
                            </div>
                            <div class="d-flex flex-wrap gap-2">
                                <a href="product/3" class="btn btn-primary rounded-pill px-4 py-2 fw-bold shadow-sm" style="background: var(--brand-gradient); border: none;">
                                    <i class="bi bi-cart3 me-1"></i> Xem Chi Tiết
                                </a>
                            </div>
                        </div>
                    }

                    <!-- Carousel Controls & Indicators -->
                    <div class="position-absolute bottom-0 end-0 m-3 d-flex gap-2 z-2">
                        <button class="btn btn-sm btn-white bg-white border shadow-sm rounded-circle d-flex align-items-center justify-content-center" style="width: 32px; height: 32px; padding: 0;" @onclick="PrevSlide">
                            <i class="bi bi-chevron-left text-dark"></i>
                        </button>
                        <div class="d-flex align-items-center gap-1 px-1">
                            @for (int s = 0; s < 3; s++)
                            {
                                var idx = s;
                                <span class="rounded-pill d-inline-block transition-all cursor-pointer @(_currentSlide == idx ? "bg-primary" : "bg-secondary bg-opacity-25")"
                                      style="width: @(_currentSlide == idx ? "24px" : "8px"); height: 8px;"
                                      @onclick="() => SetSlide(idx)"></span>
                            }
                        </div>
                        <button class="btn btn-sm btn-white bg-white border shadow-sm rounded-circle d-flex align-items-center justify-content-center" style="width: 32px; height: 32px; padding: 0;" @onclick="NextSlide">
                            <i class="bi bi-chevron-right text-dark"></i>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Col Right: 2 Stacked Promo Banners (Sáng, Tươi Mới) -->
            <div class="col-lg-3 col-md-4 d-flex flex-column gap-3">
                <!-- Promo 1: Logitech Accessories -->
                <div class="card flex-fill border rounded-4 shadow-sm p-3 text-dark overflow-hidden position-relative"
                     style="background: linear-gradient(135deg, #ecfdf5 0%, #d1fae5 100%); border-color: #a7f3d0 !important;">
                    <span class="badge bg-success text-white px-2 py-1 rounded-pill small fw-bold mb-1 align-self-start">
                        ⚡ SIÊU SALE PHỤ KIỆN
                    </span>
                    <h6 class="fw-bold mb-1 text-dark">Chuột Logitech MX Master 3S</h6>
                    <p class="text-muted small mb-2">Cảm biến 8000 DPI lướt mượt trên kính.</p>
                    <div class="d-flex justify-content-between align-items-center mt-auto">
                        <span class="fw-bold text-danger fs-6">2.490.000 ₫</span>
                        <a href="product/6" class="btn btn-sm btn-dark rounded-pill px-3 py-1 fw-bold text-white">
                            Mua ngay
                        </a>
                    </div>
                </div>

                <!-- Promo 2: Sony WH-1000XM5 -->
                <div class="card flex-fill border rounded-4 shadow-sm p-3 text-dark overflow-hidden position-relative"
                     style="background: linear-gradient(135deg, #eff6ff 0%, #dbeafe 100%); border-color: #bfdbfe !important;">
                    <span class="badge bg-danger text-white px-2 py-1 rounded-pill small fw-bold mb-1 align-self-start">
                        🎧 TUẦN LỄ ÂM THANH SONY
                    </span>
                    <h6 class="fw-bold mb-1 text-dark">Sony WH-1000XM5</h6>
                    <p class="text-muted small mb-2">Chống ồn số 1 thế giới • Pin 30 giờ.</p>
                    <div class="d-flex justify-content-between align-items-center mt-auto">
                        <span class="fw-bold text-danger fs-6">7.990.000 ₫</span>
                        <a href="product/5" class="btn btn-sm btn-primary rounded-pill px-3 py-1 fw-bold text-white" style="background: var(--brand-gradient); border: none;">
                            Xem ngay
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- 4 Golden Value Commitments Strip (Thanh 4 Cam Kết Vàng Nền Sáng) -->
        <div class="card border rounded-4 shadow-sm p-3 mt-3 bg-white" style="border-color: #e2e8f0 !important;">
            <div class="row g-2 small">
                <div class="col-6 col-lg-3 d-flex align-items-center gap-3 p-2">
                    <div class="rounded-circle d-flex align-items-center justify-content-center bg-primary-subtle text-primary flex-shrink-0" style="width: 40px; height: 40px;">
                        <i class="bi bi-truck fs-5"></i>
                    </div>
                    <div>
                        <div class="fw-bold text-dark">Giao Siêu Tốc 2 Giờ</div>
                        <div class="text-muted small">Miễn phí giao hàng hỏa tốc</div>
                    </div>
                </div>

                <div class="col-6 col-lg-3 d-flex align-items-center gap-3 p-2">
                    <div class="rounded-circle d-flex align-items-center justify-content-center bg-success-subtle text-success flex-shrink-0" style="width: 40px; height: 40px;">
                        <i class="bi bi-shield-check fs-5"></i>
                    </div>
                    <div>
                        <div class="fw-bold text-dark">100% Chính Hãng VAT</div>
                        <div class="text-muted small">Nguyên seal, bảo hành 12 tháng</div>
                    </div>
                </div>

                <div class="col-6 col-lg-3 d-flex align-items-center gap-3 p-2">
                    <div class="rounded-circle d-flex align-items-center justify-content-center bg-warning-subtle text-warning-emphasis flex-shrink-0" style="width: 40px; height: 40px;">
                        <i class="bi bi-arrow-repeat fs-5"></i>
                    </div>
                    <div>
                        <div class="fw-bold text-dark">1 Đổi 1 Trong 30 Ngày</div>
                        <div class="text-muted small">Lỗi là đổi mới không chờ đợi</div>
                    </div>
                </div>

                <div class="col-6 col-lg-3 d-flex align-items-center gap-3 p-2">
                    <div class="rounded-circle d-flex align-items-center justify-content-center bg-info-subtle text-info-emphasis flex-shrink-0" style="width: 40px; height: 40px;">
                        <i class="bi bi-credit-card fs-5"></i>
                    </div>
                    <div>
                        <div class="fw-bold text-dark">Trả Góp 0% Lãi Suất</div>
                        <div class="text-muted small">Duyệt hồ sơ nhanh trong 5 phút</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- 2. Flash Sale Section with Countdown Timer (FOMO Experience) -->
<section class="container mb-5">
    <div class="card border-0 rounded-4 overflow-hidden shadow-sm" style="background: linear-gradient(135deg, #1e1b4b 0%, #312e81 100%); color: white;">
        <div class="card-body p-4 p-lg-5">
            <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-circle bg-warning text-dark p-2 fs-4 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                        <i class="bi bi-lightning-charge-fill"></i>
                    </div>
                    <div>
                        <h3 class="fw-bold mb-0 text-white font-heading">⚡ FLASH SALE GIÁ SỐC MỖI NGÀY</h3>
                        <p class="text-white-50 small mb-0">Số lượng có hạn • Giá ưu đãi đặc biệt hôm nay</p>
                    </div>
                </div>

                <!-- Countdown Timer -->
                <div class="d-flex align-items-center gap-2">
                    <span class="small text-white-50 me-1 d-none d-sm-inline">Kết thúc trong:</span>
                    <div class="d-flex gap-1">
                        <span class="badge bg-danger fs-6 px-2 py-2 font-monospace">@_countdownHours</span>
                        <span class="text-white fw-bold align-self-center">:</span>
                        <span class="badge bg-danger fs-6 px-2 py-2 font-monospace">@_countdownMinutes</span>
                        <span class="text-white fw-bold align-self-center">:</span>
                        <span class="badge bg-danger fs-6 px-2 py-2 font-monospace">@_countdownSeconds</span>
                    </div>
                </div>
            </div>

            <!-- Flash Sale Products -->
            @if (_flashSaleProducts?.Any() == true)
            {
                <div class="row g-3">
                    @foreach (var prod in _flashSaleProducts)
                    {
                        var originalPrice = prod.Price * 1.15m;
                        var discountPercent = 15;
                        <div class="col-lg-4 col-md-6">
                            <div class="card h-100 border-0 rounded-3 p-3 bg-white text-dark shadow-sm position-relative">
                                <span class="position-absolute top-0 start-0 m-2 badge bg-danger rounded-pill px-2 py-1">
                                    -@discountPercent%
                                </span>
                                
                                <div class="d-flex gap-3 align-items-center mb-2">
                                    <img src="@(string.IsNullOrEmpty(prod.PictureUrl) ? "https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=120" : prod.PictureUrl)" 
                                         alt="@prod.Name" class="rounded-3" style="width: 80px; height: 80px; object-fit: contain;" />
                                    <div class="flex-grow-1 overflow-hidden">
                                        <div class="small text-muted text-uppercase fw-semibold" style="font-size: 0.7rem;">@prod.BrandName</div>
                                        <h6 class="fw-bold mb-1 text-truncate" title="@prod.Name">
                                            <a href="product/@prod.Id" class="text-dark text-decoration-none">@prod.Name</a>
                                        </h6>
                                        <div class="d-flex align-items-baseline gap-2">
                                            <span class="text-danger fw-bold fs-6">@prod.Price.ToString("N0") ₫</span>
                                            <span class="text-muted text-decoration-line-through small" style="font-size: 0.75rem;">@originalPrice.ToString("N0") ₫</span>
                                        </div>
                                    </div>
                                </div>

                                <!-- Progress Bar -->
                                <div class="mt-auto">
                                    <div class="d-flex justify-content-between small text-muted mb-1" style="font-size: 0.75rem;">
                                        <span><i class="bi bi-fire text-danger"></i> Đã bán 28/40 sp</span>
                                        <span class="text-danger fw-bold">Sắp hết</span>
                                    </div>
                                    <div class="progress" style="height: 6px;">
                                        <div class="progress-bar bg-danger" role="progressbar" style="width: 70%"></div>
                                    </div>
                                    <div class="d-flex gap-2 mt-3">
                                        <button class="btn btn-sm btn-outline-primary flex-grow-1 rounded-pill"
                                                @onclick="() => AddToCartAsync(prod)">
                                            <i class="bi bi-cart-plus"></i> Thêm giỏ
                                        </button>
                                        <button class="btn btn-sm btn-primary flex-grow-1 rounded-pill"
                                                style="background: var(--brand-gradient); border: none;"
                                                @onclick="() => BuyNowAsync(prod)">
                                            <i class="bi bi-lightning-fill"></i> Mua ngay
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

<!-- 3. Product Catalog Section (Advanced Filter & Search) -->
<section id="product-catalog" class="container mb-5">
    <!-- Section Title & Subtitle -->
    <div class="d-flex flex-wrap justify-content-between align-items-end mb-4 gap-2">
        <div>
            <h2 class="fw-bold mb-1 font-heading">Danh Mục Sản Phẩm Công Nghệ</h2>
            <p class="text-muted mb-0">Tìm kiếm theo thương hiệu, mức giá, cấu hình RAM/ROM hoặc tên thiết bị</p>
        </div>
        <div class="text-muted small">
            @if (_products != null)
            {
                <span>Hiển thị <strong>@GetFilteredAndSortedItems().Count()</strong> sản phẩm phù hợp</span>
            }
        </div>
    </div>

    <!-- Category Chips Filter -->
    <div class="d-flex flex-wrap gap-2 mb-4 overflow-auto pb-2">
        <button class="category-chip @(!_selectedCategoryId.HasValue ? "active" : "")" 
                @onclick="() => FilterByCategory(null)">
            <i class="bi bi-grid-fill"></i> Tất cả ngành hàng
        </button>
        @if (_categories != null)
        {
            @foreach (var cat in _categories)
            {
                var isSelected = _selectedCategoryId == cat.Id;
                <button class="category-chip @(isSelected ? "active" : "")" 
                        @onclick="() => FilterByCategory(cat.Id)">
                    <span>@cat.Name</span>
                </button>
            }
        }
    </div>

    <!-- Advanced Filters & Search Toolbar -->
    <div class="card border-0 shadow-sm rounded-4 p-3 mb-4 bg-white">
        <div class="row g-3 align-items-center">
            <!-- Search input -->
            <div class="col-lg-4 col-md-6">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
                    <input type="text" class="form-control border-start-0 border-end-0" 
                           placeholder="Tìm kiếm iPhone, S24, MacBook, Sony, Logitech..." 
                           @bind="_searchTerm" 
                           @bind:event="oninput" 
                           @onkeyup="OnSearchKeyUp" />
                    @if (!string.IsNullOrWhiteSpace(_searchTerm))
                    {
                        <button class="btn btn-white border-start-0 text-muted" type="button" @onclick="ClearSearch">
                            <i class="bi bi-x-circle-fill"></i>
                        </button>
                    }
                </div>
            </div>

            <!-- Brand Filter -->
            <div class="col-lg-2 col-md-3">
                <select class="form-select border-1" value="@(_selectedBrandId?.ToString() ?? "")" @onchange="OnBrandChanged">
                    <option value="">Thương hiệu: Tất cả</option>
                    @if (_brands != null)
                    {
                        @foreach (var brand in _brands)
                        {
                            <option value="@brand.Id">@brand.Name</option>
                        }
                    }
                </select>
            </div>

            <!-- Price Range Filter -->
            <div class="col-lg-2 col-md-3">
                <select class="form-select border-1" @bind="_selectedPriceRange">
                    <option value="">Mức giá: Tất cả</option>
                    <option value="under-5m">Dưới 5 triệu</option>
                    <option value="5m-15m">Từ 5 - 15 triệu</option>
                    <option value="15m-30m">Từ 15 - 30 triệu</option>
                    <option value="above-30m">Trên 30 triệu</option>
                </select>
            </div>

            <!-- RAM / Core Spec Filter -->
            <div class="col-lg-2 col-md-6">
                <select class="form-select border-1" @bind="_selectedRamFilter">
                    <option value="">Dung lượng RAM: Tất cả</option>
                    <option value="8GB">8 GB RAM</option>
                    <option value="12GB">12 GB RAM</option>
                    <option value="16GB">16 GB RAM</option>
                    <option value="18GB">18 GB RAM</option>
                    <option value="32GB">32 GB RAM</option>
                </select>
            </div>

            <!-- Sort selector -->
            <div class="col-lg-2 col-md-6">
                <select class="form-select border-1" @bind="_sortOrder">
                    <option value="newest">Mới nhất</option>
                    <option value="price-asc">Giá: Thấp đến Cao</option>
                    <option value="price-desc">Giá: Cao đến Thấp</option>
                </select>
            </div>
        </div>
    </div>

    <!-- 4. Product Grid -->
    @if (_isLoading)
    {
        <!-- Skeleton Loading Cards -->
        <div class="row g-4">
            @for (int i = 0; i < 6; i++)
            {
                <div class="col-lg-4 col-md-6">
                    <div class="skeleton-card">
                        <div class="skeleton-box mb-3" style="height: 200px;"></div>
                        <div class="skeleton-box mb-2" style="height: 18px; width: 40%;"></div>
                        <div class="skeleton-box mb-2" style="height: 24px; width: 85%;"></div>
                        <div class="skeleton-box mb-3" style="height: 16px; width: 95%;"></div>
                        <div class="d-flex justify-content-between align-items-center">
                            <div class="skeleton-box" style="height: 28px; width: 45%;"></div>
                            <div class="skeleton-box" style="height: 38px; width: 35%; border-radius: 9999px;"></div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        var displayItems = GetFilteredAndSortedItems().ToList();

        @if (!displayItems.Any())
        {
            <div class="text-center py-5 bg-white rounded-4 border">
                <i class="bi bi-search text-muted fs-1 mb-2"></i>
                <h5 class="text-dark fw-bold">Không tìm thấy sản phẩm phù hợp</h5>
                <p class="text-secondary small mb-3">Hãy thử thay đổi từ khóa tìm kiếm hoặc đặt lại các bộ lọc thông số.</p>
                <button class="btn btn-outline-primary rounded-pill px-4" @onclick="ResetFilters">
                    <i class="bi bi-arrow-counterclockwise me-1"></i> Đặt lại bộ lọc
                </button>
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var product in displayItems)
                {
                    var isComparing = ComparisonState.IsInComparison(product.Id);
                    var specs = ProductSpecsProvider.GetSpecs(product);

                    <div class="col-lg-4 col-md-6">
                        <div class="product-card d-flex flex-column h-100">
                            <!-- Image Container -->
                            <div class="product-image-container position-relative">
                                <a href="product/@product.Id">
                                    <img src="@(string.IsNullOrEmpty(product.PictureUrl) ? "https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=500" : product.PictureUrl)" 
                                         alt="@product.Name" loading="lazy" />
                                </a>
                                
                                <!-- Brand Badge (Top Left) -->
                                <div class="position-absolute top-0 start-0 m-3">
                                    <span class="badge bg-dark bg-opacity-75 backdrop-blur rounded-pill px-2 py-1 small">
                                        @product.BrandName
                                    </span>
                                </div>

                                <!-- Compare Button (Top Right) -->
                                <div class="position-absolute top-0 end-0 m-3">
                                    <button class="btn btn-sm @(isComparing ? "btn-warning text-dark" : "btn-light") rounded-circle shadow-sm"
                                            style="width: 34px; height: 34px; padding: 0; display: flex; align-items: center; justify-content: center;"
                                            title="@(isComparing ? "Đã trong danh sách so sánh" : "Thêm vào so sánh thông số")"
                                            @onclick="() => ToggleComparison(product)">
                                        <i class="bi @(isComparing ? "bi-check-lg fw-bold" : "bi-arrow-left-right")"></i>
                                    </button>
                                </div>

                                <!-- Stock Badge (Bottom Left) -->
                                <div class="position-absolute bottom-0 start-0 m-3">
                                    @if (product.AvailableStock > 0)
                                    {
                                        <span class="badge bg-success rounded-pill px-2 py-1 small fw-medium">
                                            <i class="bi bi-check-circle-fill me-1"></i> Còn @product.AvailableStock sp
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger rounded-pill px-2 py-1 small fw-medium">
                                            <i class="bi bi-x-circle-fill me-1"></i> Tạm hết hàng
                                        </span>
                                    }
                                </div>
                            </div>

                            <!-- Card Content -->
                            <div class="p-4 d-flex flex-column flex-grow-1">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="text-muted small fw-semibold text-uppercase" style="font-size: 0.72rem; letter-spacing: 0.05em;">
                                        @product.CategoryName
                                    </span>
                                    <span class="badge bg-light text-secondary border small">Mã: @product.SKU</span>
                                </div>

                                <h5 class="fw-bold mb-2 text-dark font-heading" style="font-size: 1.15rem; line-height: 1.3;">
                                    <a href="product/@product.Id" class="text-decoration-none text-dark hover-primary">
                                        @product.Name
                                    </a>
                                </h5>

                                <!-- Core Tech Specs Snippet -->
                                <div class="d-flex flex-wrap gap-1 mb-3">
                                    <span class="badge bg-light text-dark border small"><i class="bi bi-cpu me-1 text-primary"></i>@specs.Cpu.Split('(')[0].Trim()</span>
                                    <span class="badge bg-light text-dark border small"><i class="bi bi-memory me-1 text-success"></i>@specs.Ram</span>
                                    <span class="badge bg-light text-dark border small"><i class="bi bi-hdd me-1 text-info"></i>@specs.Storage</span>
                                </div>

                                <p class="text-secondary small mb-3 flex-grow-1" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                    @product.Description
                                </p>

                                <!-- Price Display -->
                                <div class="pt-2 mb-3 border-top d-flex justify-content-between align-items-baseline">
                                    <div>
                                        <div class="small text-muted" style="font-size: 0.72rem;">Giá niêm yết:</div>
                                        <div class="product-price fw-bold text-primary fs-5">
                                            @product.Price.ToString("N0") ₫
                                        </div>
                                    </div>
                                    <div class="small text-success fw-semibold">
                                        <i class="bi bi-shield-check"></i> Bảo hành 12T
                                    </div>
                                </div>

                                <!-- Dual Action Buttons: Thêm vào giỏ & Mua ngay -->
                                <div class="d-flex gap-2">
                                    <button class="btn btn-outline-primary btn-sm rounded-pill flex-grow-1 py-2 d-flex align-items-center justify-content-center gap-1"
                                            disabled="@(product.AvailableStock <= 0 || _addingProductId == product.Id)"
                                            @onclick="() => AddToCartAsync(product)">
                                        @if (_addingProductId == product.Id)
                                        {
                                            <span class="spinner-border spinner-border-sm" role="status"></span>
                                            <span class="small">Đang thêm...</span>
                                        }
                                        else
                                        {
                                            <i class="bi bi-cart-plus"></i>
                                            <span class="small fw-semibold">Thêm vào giỏ</span>
                                        }
                                    </button>

                                    <button class="btn btn-primary btn-sm rounded-pill flex-grow-1 py-2 d-flex align-items-center justify-content-center gap-1 shadow-sm"
                                            style="background: var(--brand-gradient); border: none;"
                                            disabled="@(product.AvailableStock <= 0)"
                                            @onclick="() => BuyNowAsync(product)">
                                        <i class="bi bi-lightning-fill"></i>
                                        <span class="small fw-semibold">Mua ngay</span>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- Pagination Controls -->
            @if (_products != null && _products.TotalPages > 1)
            {
                <div class="d-flex justify-content-center align-items-center gap-2 mt-5">
                    <button class="btn btn-outline-secondary rounded-pill px-3 py-1" 
                            disabled="@(!_products.HasPreviousPage)" 
                            @onclick="() => ChangePage(_pageIndex - 1)">
                        <i class="bi bi-chevron-left me-1"></i> Trang trước
                    </button>
                    
                    <span class="small text-muted px-2">
                        Trang <strong>@_products.PageIndex</strong> / @_products.TotalPages
                    </span>

                    <button class="btn btn-outline-secondary rounded-pill px-3 py-1" 
                            disabled="@(!_products.HasNextPage)" 
                            @onclick="() => ChangePage(_pageIndex + 1)">
                        Trang sau <i class="bi bi-chevron-right ms-1"></i>
                    </button>
                </div>
            }
        }
    }
</section>

@code {
    [SupplyParameterFromQuery(Name = "search")]
    public string? SearchFromQuery { get; set; }

    private PaginatedList<ProductDto>? _products;
    private List<ProductDto>? _flashSaleProducts;
    private List<BrandDto>? _brands;
    private List<CategoryDto>? _categories;

    private int _currentSlide = 0;
    private System.Threading.Timer? _slideTimer;

    private int _pageIndex = 1;
    private const int PageSize = 12;
    private int? _selectedBrandId;
    private int? _selectedCategoryId;
    private string _selectedPriceRange = "";
    private string _selectedRamFilter = "";
    private string _searchTerm = "";
    private string _sortOrder = "newest";
    private bool _isLoading = true;
    private int? _addingProductId;

    // Countdown Timer State
    private System.Threading.Timer? _countdownTimer;
    private string _countdownHours = "08";
    private string _countdownMinutes = "45";
    private string _countdownSeconds = "20";
    private int _totalSecondsRemaining = 8 * 3600 + 45 * 60 + 20;

    protected override async Task OnInitializedAsync()
    {
        ComparisonState.OnChange += StateHasChanged;
        StartCountdownTimer();
        StartSlideAutoRotate();
        await LoadMetadataAsync();
        await LoadProductsAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!string.IsNullOrWhiteSpace(SearchFromQuery) && SearchFromQuery != _searchTerm)
        {
            _searchTerm = SearchFromQuery;
            _pageIndex = 1;
            await LoadProductsAsync();
        }
    }

    private void StartSlideAutoRotate()
    {
        _slideTimer = new System.Threading.Timer(_ =>
        {
            _currentSlide = (_currentSlide + 1) % 3;
            InvokeAsync(StateHasChanged);
        }, null, 5000, 5000);
    }

    private void NextSlide()
    {
        _currentSlide = (_currentSlide + 1) % 3;
    }

    private void PrevSlide()
    {
        _currentSlide = (_currentSlide - 1 + 3) % 3;
    }

    private void SetSlide(int index)
    {
        _currentSlide = index;
    }

    private void StartCountdownTimer()
    {
        _countdownTimer = new System.Threading.Timer(_ =>
        {
            if (_totalSecondsRemaining > 0)
            {
                _totalSecondsRemaining--;
                var hours = _totalSecondsRemaining / 3600;
                var minutes = (_totalSecondsRemaining % 3600) / 60;
                var seconds = _totalSecondsRemaining % 60;

                _countdownHours = hours.ToString("D2");
                _countdownMinutes = minutes.ToString("D2");
                _countdownSeconds = seconds.ToString("D2");

                InvokeAsync(StateHasChanged);
            }
        }, null, 1000, 1000);
    }

    private async Task LoadMetadataAsync()
    {
        try
        {
            var brandsTask = ApiClient.GetBrandsAsync();
            var categoriesTask = ApiClient.GetCategoriesAsync();
            await Task.WhenAll(brandsTask, categoriesTask);

            _brands = await brandsTask;
            _categories = await categoriesTask;
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Lỗi nạp danh mục: {ex.Message}");
        }
    }

    private async Task LoadProductsAsync()
    {
        _isLoading = true;
        try
        {
            _products = await ApiClient.GetProductsAsync(
                pageIndex: _pageIndex,
                pageSize: PageSize,
                brandId: _selectedBrandId,
                categoryId: _selectedCategoryId,
                searchTerm: _searchTerm
            );

            if (_flashSaleProducts == null && _products?.Items?.Any() == true)
            {
                _flashSaleProducts = _products.Items.Take(3).ToList();
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Lỗi nạp sản phẩm: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private IEnumerable<ProductDto> GetFilteredAndSortedItems()
    {
        if (_products == null) return Enumerable.Empty<ProductDto>();

        var query = _products.Items.AsEnumerable();

        if (!string.IsNullOrEmpty(_selectedPriceRange))
        {
            query = _selectedPriceRange switch
            {
                "under-5m" => query.Where(p => p.Price < 5000000m),
                "5m-15m" => query.Where(p => p.Price >= 5000000m && p.Price < 15000000m),
                "15m-30m" => query.Where(p => p.Price >= 15000000m && p.Price < 30000000m),
                "above-30m" => query.Where(p => p.Price >= 30000000m),
                _ => query
            };
        }

        if (!string.IsNullOrEmpty(_selectedRamFilter))
        {
            query = query.Where(p =>
            {
                var specs = ProductSpecsProvider.GetSpecs(p);
                return specs.Ram.Contains(_selectedRamFilter, StringComparison.OrdinalIgnoreCase);
            });
        }

        return _sortOrder switch
        {
            "price-asc" => query.OrderBy(p => p.Price),
            "price-desc" => query.OrderByDescending(p => p.Price),
            _ => query
        };
    }

    private async Task FilterByCategory(int? categoryId)
    {
        _selectedCategoryId = categoryId;
        _pageIndex = 1;
        await LoadProductsAsync();
    }

    private async Task OnBrandChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var brandId))
            _selectedBrandId = brandId;
        else
            _selectedBrandId = null;

        _pageIndex = 1;
        await LoadProductsAsync();
    }

    private async Task OnSearchKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            _pageIndex = 1;
            await LoadProductsAsync();
        }
    }

    private async Task ClearSearch()
    {
        _searchTerm = "";
        _pageIndex = 1;
        await LoadProductsAsync();
    }

    private async Task ResetFilters()
    {
        _searchTerm = "";
        _selectedBrandId = null;
        _selectedCategoryId = null;
        _selectedPriceRange = "";
        _selectedRamFilter = "";
        _sortOrder = "newest";
        _pageIndex = 1;
        await LoadProductsAsync();
    }

    private async Task ChangePage(int newPage)
    {
        _pageIndex = newPage;
        await LoadProductsAsync();
    }

    private void ToggleComparison(ProductDto product)
    {
        if (ComparisonState.IsInComparison(product.Id))
        {
            ComparisonState.RemoveProduct(product.Id);
            ToastService.ShowInfo($"Đã bỏ {product.Name} khỏi danh sách so sánh.");
        }
        else
        {
            if (ComparisonState.AddProduct(product, out var msg))
            {
                ToastService.ShowSuccess(msg, "So sánh sản phẩm");
            }
            else
            {
                ToastService.ShowWarning(msg);
            }
        }
    }

    private async Task AddToCartAsync(ProductDto product)
    {
        if (!AuthState.IsAuthenticated)
        {
            ToastService.ShowWarning("Vui lòng đăng nhập tài khoản để thêm sản phẩm vào giỏ hàng.", "Yêu cầu đăng nhập");
            return;
        }

        _addingProductId = product.Id;
        try
        {
            var buyerId = AuthState.CurrentBuyerId;
            var updatedBasket = await ApiClient.AddItemToBasketAsync(buyerId, product.Id, 1);

            if (updatedBasket != null)
            {
                ToastService.ShowSuccess($"Đã thêm {product.Name} vào giỏ hàng!", "Giỏ hàng");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Không thể thêm vào giỏ: {ex.Message}");
        }
        finally
        {
            _addingProductId = null;
        }
    }

    private async Task BuyNowAsync(ProductDto product)
    {
        await AddToCartAsync(product);
        if (AuthState.IsAuthenticated)
        {
            NavigationManager.NavigateTo("checkout");
        }
    }

    public void Dispose()
    {
        _slideTimer?.Dispose();
        _countdownTimer?.Dispose();
        ComparisonState.OnChange -= StateHasChanged;
    }
}
