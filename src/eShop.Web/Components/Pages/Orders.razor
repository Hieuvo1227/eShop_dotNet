@page "/orders"
@inject ShopApiClient ApiClient
@inject AuthStateService AuthState
@inject ToastService ToastService
@inject NavigationManager Navigation

<PageTitle>Lịch sử Đơn hàng • eShop</PageTitle>

<div class="container py-4">
    <!-- Payment Return Banner -->
    @if (!string.IsNullOrWhiteSpace(_paymentBannerMessage))
    {
        <div class="alert @(_isPaymentBannerSuccess ? "alert-success" : "alert-warning") rounded-4 p-4 shadow-sm mb-4 d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-3">
                <i class="bi @(_isPaymentBannerSuccess ? "bi-check-circle-fill text-success" : "bi-exclamation-triangle-fill text-warning") fs-3"></i>
                <div>
                    <h5 class="fw-bold mb-1">@_paymentBannerTitle</h5>
                    <div class="small">@_paymentBannerMessage</div>
                </div>
            </div>
            <button type="button" class="btn-close" @onclick="() => _paymentBannerMessage = null"></button>
        </div>
    }

    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h2 class="fw-bold mb-1 d-flex align-items-center gap-2">
                <i class="bi bi-receipt text-primary"></i> Lịch Sử Đơn Hàng
            </h2>
            <p class="text-muted small mb-0">Theo dõi trạng thái xử lý đơn hàng và giao vận thời gian thực</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-light text-secondary border px-3 py-2 rounded-pill small">
                Tài khoản: <strong>@AuthState.CurrentUser?.Email</strong>
            </span>
            <button class="btn btn-outline-secondary btn-sm rounded-pill px-3" @onclick="LoadOrdersAsync" disabled="@_isLoading">
                <i class="bi bi-arrow-clockwise me-1"></i> Làm mới
            </button>
        </div>
    </div>

    @if (_isLoading)
    {
        <div class="row g-4">
            @for (int i = 0; i < 3; i++)
            {
                <div class="col-12">
                    <div class="skeleton-card">
                        <div class="d-flex justify-content-between mb-3">
                            <div class="skeleton-box" style="height: 24px; width: 30%;"></div>
                            <div class="skeleton-box" style="height: 24px; width: 15%;"></div>
                        </div>
                        <div class="skeleton-box mb-2" style="height: 60px; width: 100%;"></div>
                        <div class="skeleton-box" style="height: 20px; width: 40%;"></div>
                    </div>
                </div>
            }
        </div>
    }
    else if (_orders == null || !_orders.Any())
    {
        <div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-white my-4 mx-auto" style="max-width: 550px;">
            <div class="d-inline-flex p-4 rounded-circle mb-3 mx-auto text-muted" style="background: #f1f5f9; font-size: 3rem;">
                <i class="bi bi-inbox"></i>
            </div>
            <h4 class="fw-bold text-dark mb-2">Chưa có đơn hàng nào</h4>
            <p class="text-secondary small mb-4">
                Bạn chưa thực hiện đơn đặt hàng nào trong hệ thống. Hãy chọn cho mình những món đồ công nghệ yêu thích ngay hôm nay!
            </p>
            <div>
                <a href="" class="btn btn-brand rounded-pill px-4 py-2">
                    <i class="bi bi-cart-plus me-1"></i> Bắt Đầu Mua Sắm
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="d-flex flex-column gap-4">
            @foreach (var order in _orders.OrderByDescending(o => o.OrderDateUtc))
            {
                <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden">
                    <!-- Order Card Header -->
                    <div class="p-4 border-bottom bg-light bg-opacity-50 d-flex flex-wrap justify-content-between align-items-center gap-2">
                        <div class="d-flex align-items-center gap-2">
                            <div class="fw-bold fs-5 text-dark font-heading">
                                Đơn Hàng <span class="text-primary font-monospace">#@order.Id</span>
                            </div>
                            <span class="badge rounded-pill px-3 py-1 fw-semibold @GetStatusBadgeClass(order.Status)">
                                @GetStatusDisplayName(order.Status)
                            </span>
                            <span class="badge bg-light text-secondary border rounded-pill px-2 py-1 small">
                                <i class="bi bi-wallet2 me-1"></i> @order.PaymentMethod
                            </span>
                        </div>
                        <div class="text-muted small">
                            <i class="bi bi-calendar3 me-1"></i> 
                            @order.OrderDateUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")
                        </div>
                    </div>

                    <!-- Order Card Body -->
                    <div class="p-4">
                        <!-- Items Table -->
                        <div class="table-responsive mb-3">
                            <table class="table table-borderless align-middle mb-0">
                                <tbody>
                                    @foreach (var item in order.Items)
                                    {
                                        <tr class="border-bottom border-light">
                                            <td style="width: 60px;">
                                                <img src="@(string.IsNullOrEmpty(item.PictureUrl) ? "https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=100" : item.PictureUrl)" 
                                                     alt="@item.ProductName" class="rounded-3 border" style="width: 50px; height: 50px; object-fit: cover;" />
                                            </td>
                                            <td>
                                                <div class="fw-semibold text-dark">@item.ProductName</div>
                                                <div class="text-muted small">Số lượng: <strong>@item.Units</strong> x @item.UnitPrice.ToString("N0") ₫</div>
                                            </td>
                                            <td class="text-end fw-bold text-dark">
                                                @item.TotalPrice.ToString("N0") ₫
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <!-- Footer Details -->
                        <div class="d-flex flex-wrap justify-content-between align-items-center pt-2">
                            <div class="small text-muted mb-2 mb-md-0">
                                <i class="bi bi-geo-alt me-1 text-danger"></i>
                                Giao tới: <strong class="text-dark">@order.ShippingAddress.Street, @order.ShippingAddress.District, @order.ShippingAddress.City</strong>
                            </div>

                            <div class="d-flex align-items-center gap-4">
                                <div class="text-end">
                                    <div class="small text-muted">Tổng thanh toán:</div>
                                    <div class="fs-5 fw-bold text-primary font-heading">
                                        @order.TotalAmount.ToString("N0") ₫
                                    </div>
                                </div>

                                @if (order.Status.Equals("AwaitingPayment", StringComparison.OrdinalIgnoreCase))
                                {
                                    <button class="btn btn-sm btn-brand rounded-pill px-3 py-1 shadow-sm"
                                            @onclick="() => PayWithVnPayAsync(order.Id)">
                                        <i class="bi bi-credit-card me-1"></i> Thanh Toán VNPay
                                    </button>
                                }

                                @if (order.Status.Equals("Submitted", StringComparison.OrdinalIgnoreCase) || 
                                     order.Status.Equals("AwaitingPayment", StringComparison.OrdinalIgnoreCase))
                                {
                                    <button class="btn btn-sm btn-outline-danger rounded-pill px-3 py-1"
                                            disabled="@(_cancellingOrderId == order.Id)"
                                            @onclick="() => CancelOrderAsync(order.Id)">
                                        @if (_cancellingOrderId == order.Id)
                                        {
                                            <span class="spinner-border spinner-border-sm me-1"></span>
                                            <span>Đang hủy...</span>
                                        }
                                        else
                                        {
                                            <i class="bi bi-x-circle me-1"></i>
                                            <span>Hủy Đơn Hàng</span>
                                        }
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<OrderDto>? _orders;
    private bool _isLoading = true;
    private int? _cancellingOrderId;
    private string? _paymentBannerTitle;
    private string? _paymentBannerMessage;
    private bool _isPaymentBannerSuccess;

    protected override async Task OnInitializedAsync()
    {
        CheckPaymentReturn();
        await LoadOrdersAsync();
    }

    private void CheckPaymentReturn()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);

        if (query.TryGetValue("paymentSuccess", out var successVal))
        {
            var isSuccess = successVal.ToString().Equals("true", StringComparison.OrdinalIgnoreCase);
            var orderId = query.TryGetValue("orderId", out var idVal) ? idVal.ToString() : "";

            if (isSuccess)
            {
                _isPaymentBannerSuccess = true;
                _paymentBannerTitle = "Thanh toán VNPay thành công!";
                _paymentBannerMessage = $"Đơn hàng #{orderId} đã được thanh toán thành công qua cổng VNPay. Hệ thống đang tiến hành điều phối xuất kho.";
                ToastService.ShowSuccess($"Đơn hàng #{orderId} đã thanh toán thành công!", "VNPay Sandbox");
            }
            else
            {
                _isPaymentBannerSuccess = false;
                _paymentBannerTitle = "Giao dịch VNPay chưa hoàn tất";
                _paymentBannerMessage = $"Giao dịch cho đơn hàng #{orderId} đã bị hủy hoặc không thành công. Bạn có thể bấm 'Thanh Toán VNPay' để thử lại.";
                ToastService.ShowWarning("Thanh toán chưa hoàn tất. Bạn có thể thử lại bất cứ lúc nào.");
            }
        }
        else if (query.TryGetValue("newOrder", out var newIdVal))
        {
            _isPaymentBannerSuccess = true;
            _paymentBannerTitle = "Đặt hàng thành công!";
            _paymentBannerMessage = $"Đơn hàng #{newIdVal} (hình thức COD) đã được tiếp nhận. Đơn vị vận chuyển sẽ giao hàng tới bạn trong thời gian sớm nhất.";
        }
    }

    private async Task PayWithVnPayAsync(int orderId)
    {
        try
        {
            var paymentUrl = await ApiClient.GetVnPayPaymentUrlAsync(orderId);
            if (!string.IsNullOrWhiteSpace(paymentUrl))
            {
                Navigation.NavigateTo(paymentUrl, forceLoad: true);
            }
            else
            {
                ToastService.ShowError("Không thể tạo liên kết thanh toán VNPay. Vui lòng thử lại sau.");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError(ex.Message);
        }
    }

    private async Task LoadOrdersAsync()
    {
        _isLoading = true;
        try
        {
            var buyerId = AuthState.CurrentBuyerId;
            _orders = await ApiClient.GetOrdersByBuyerIdAsync(buyerId);
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Lỗi nạp đơn hàng: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task CancelOrderAsync(int orderId)
    {
        _cancellingOrderId = orderId;
        try
        {
            var success = await ApiClient.CancelOrderAsync(orderId);
            if (success)
            {
                ToastService.ShowSuccess($"Đơn hàng #{orderId} đã được hủy và tồn kho đã được hoàn trả thành công!", "Hủy đơn hàng");
                await LoadOrdersAsync();
            }
            else
            {
                ToastService.ShowError("Không thể hủy đơn hàng này. Vui lòng kiểm tra lại trạng thái.");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError(ex.Message);
        }
        finally
        {
            _cancellingOrderId = null;
        }
    }

    private string GetStatusBadgeClass(string status) => status?.ToLowerInvariant() switch
    {
        "submitted" => "bg-primary-subtle text-primary border border-primary border-opacity-25",
        "awaitingpayment" => "bg-warning-subtle text-warning border border-warning border-opacity-25",
        "paid" => "bg-success-subtle text-success border border-success border-opacity-25",
        "shipped" => "bg-info-subtle text-info border border-info border-opacity-25",
        "cancelled" => "bg-danger-subtle text-danger border border-danger border-opacity-25",
        _ => "bg-secondary-subtle text-secondary"
    };

    private string GetStatusDisplayName(string status) => status?.ToLowerInvariant() switch
    {
        "submitted" => "Đã tiếp nhận (Chờ xử lý)",
        "awaitingpayment" => "Chờ thanh toán",
        "paid" => "Đã thanh toán",
        "shipped" => "Đang giao hàng",
        "cancelled" => "Đã hủy",
        _ => status ?? "Không xác định"
    };
}
