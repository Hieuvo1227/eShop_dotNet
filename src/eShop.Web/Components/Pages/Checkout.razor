@page "/checkout"
@using eShop.Web.Components.Shared
@inject ShopApiClient ApiClient
@inject CartStateService CartState
@inject AuthStateService AuthState
@inject ToastService ToastService
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>Thanh toán đơn hàng • eShop</PageTitle>

<div class="container py-4">
    <!-- Header -->
    <div class="mb-4 pb-2 border-bottom d-flex justify-content-between align-items-center">
        <div>
            <h2 class="fw-bold mb-1 d-flex align-items-center gap-2">
                <i class="bi bi-shield-check text-primary"></i> Tiến Hành Thanh Toán
            </h2>
            <p class="text-muted small mb-0">Xác nhận thông tin giao hàng và chọn phương thức thanh toán an toàn</p>
        </div>
        <a href="cart" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
            <i class="bi bi-cart3 me-1"></i> Quay Lại Giỏ Hàng
        </a>
    </div>

    @if (!AuthState.IsAuthenticated)
    {
        <!-- Yêu cầu đăng nhập -->
        <div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-white my-4 mx-auto" style="max-width: 550px;">
            <div class="d-inline-flex p-4 rounded-circle mb-3 mx-auto text-primary" style="background: rgba(37, 99, 235, 0.1); font-size: 3rem;">
                <i class="bi bi-person-lock"></i>
            </div>
            <h4 class="fw-bold text-dark mb-2">Vui lòng đăng nhập để thanh toán</h4>
            <p class="text-secondary small mb-4">
                Để bảo vệ quyền lợi, theo dõi trạng thái giao hàng và tích lũy ưu đãi, vui lòng đăng nhập tài khoản của bạn.
            </p>
            <div class="d-flex justify-content-center gap-2">
                <button class="btn btn-brand rounded-pill px-4 py-2" @onclick="() => _showAuthModal = true">
                    <i class="bi bi-box-arrow-in-right me-1"></i> Đăng Nhập Ngay
                </button>
                <a href="" class="btn btn-outline-secondary rounded-pill px-4 py-2">
                    Về Trang Chủ
                </a>
            </div>
        </div>
    }
    else if (CartState.Basket == null || !CartState.Basket.Items.Any())
    {
        <!-- Giỏ hàng rỗng -->
        <div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-white my-4 mx-auto" style="max-width: 550px;">
            <div class="d-inline-flex p-4 rounded-circle mb-3 mx-auto text-muted" style="background: #f1f5f9; font-size: 3rem;">
                <i class="bi bi-cart-x"></i>
            </div>
            <h4 class="fw-bold text-dark mb-2">Giỏ hàng của bạn đang trống</h4>
            <p class="text-secondary small mb-4">
                Bạn chưa có sản phẩm nào trong giỏ hàng để thực hiện thanh toán.
            </p>
            <div>
                <a href="" class="btn btn-brand rounded-pill px-4 py-2">
                    <i class="bi bi-arrow-left me-1"></i> Mua Sắm Ngay
                </a>
            </div>
        </div>
    }
    else
    {
        <!-- Form Checkout 2 Cột -->
        <div class="row g-4">
            <!-- Left: Shipping & Payment Form -->
            <div class="col-lg-7">
                <!-- 1. Thông tin người nhận -->
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
                    <h5 class="fw-bold text-dark font-heading mb-3 d-flex align-items-center gap-2">
                        <i class="bi bi-geo-alt-fill text-primary"></i> 1. Địa Chỉ Nhận Hàng
                    </h5>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Họ và tên người nhận:</label>
                            <input type="text" class="form-control" value="@AuthState.CurrentUser?.FullName" readonly />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Số điện thoại liên hệ: <span class="text-danger">*</span></label>
                            <input type="tel" class="form-control" placeholder="VD: 0912 345 678" @bind="_phoneNumber" />
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-semibold">Số nhà / Tên đường: <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" placeholder="VD: 123 Nguyễn Huệ, P. Bến Nghé" @bind="_shippingAddress.Street" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Quận / Huyện: <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" placeholder="VD: Quận 1" @bind="_shippingAddress.District" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Tỉnh / Thành phố: <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" placeholder="VD: TP. Hồ Chí Minh" @bind="_shippingAddress.City" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Mã bưu điện (Zip Code):</label>
                            <input type="text" class="form-control" placeholder="70000" @bind="_shippingAddress.ZipCode" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Quốc gia:</label>
                            <input type="text" class="form-control" value="Vietnam" readonly />
                        </div>
                    </div>
                </div>

                <!-- 2. Phương thức thanh toán -->
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
                    <h5 class="fw-bold text-dark font-heading mb-3 d-flex align-items-center gap-2">
                        <i class="bi bi-credit-card-fill text-primary"></i> 2. Phương Thức Thanh Toán
                    </h5>

                    <div class="d-flex flex-column gap-3">
                        <!-- Option: VNPay -->
                        <label class="d-flex align-items-center p-3 rounded-4 border cursor-pointer @(_paymentMethod == "VNPay" ? "border-primary bg-primary bg-opacity-10" : "bg-light")">
                            <input type="radio" name="paymentMethod" value="VNPay" class="form-check-input me-3 mt-0" 
                                   checked="@(_paymentMethod == "VNPay")" 
                                   @onchange='() => _paymentMethod = "VNPay"' />
                            <div class="d-flex align-items-center gap-3 flex-grow-1">
                                <div class="rounded-3 p-2 bg-white shadow-sm border text-primary fw-bold fs-5" style="width: 52px; text-align: center;">
                                    VN
                                </div>
                                <div>
                                    <div class="fw-bold text-dark d-flex align-items-center gap-2">
                                        Cổng Thanh Toán VNPay
                                        <span class="badge bg-success rounded-pill small">Khuyên dùng • Sandbox</span>
                                    </div>
                                    <div class="text-muted small">Thanh toán tức thì qua VNPay QR, Thẻ ATM Nội Địa, Thẻ Quốc Tế (Visa/MasterCard)</div>
                                </div>
                            </div>
                        </label>

                        <!-- Option: COD -->
                        <label class="d-flex align-items-center p-3 rounded-4 border cursor-pointer @(_paymentMethod == "COD" ? "border-primary bg-primary bg-opacity-10" : "bg-light")">
                            <input type="radio" name="paymentMethod" value="COD" class="form-check-input me-3 mt-0" 
                                   checked="@(_paymentMethod == "COD")" 
                                   @onchange='() => _paymentMethod = "COD"' />
                            <div class="d-flex align-items-center gap-3 flex-grow-1">
                                <div class="rounded-3 p-2 bg-white shadow-sm border text-secondary fs-4 text-center" style="width: 52px;">
                                    <i class="bi bi-cash-stack"></i>
                                </div>
                                <div>
                                    <div class="fw-bold text-dark">Thanh Toán Khi Nhận Hàng (COD)</div>
                                    <div class="text-muted small">Nhận hàng, kiểm tra sản phẩm trước và thanh toán tiền mặt trực tiếp cho nhân viên giao hàng</div>
                                </div>
                            </div>
                        </label>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(_errorMessage))
                {
                    <div class="alert alert-danger rounded-4 p-3 d-flex align-items-center gap-2">
                        <i class="bi bi-exclamation-circle-fill fs-5"></i>
                        <div>@_errorMessage</div>
                    </div>
                }
            </div>

            <!-- Right: Order Summary Sidebar -->
            <div class="col-lg-5">
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-white sticky-top" style="top: 80px;">
                    <h5 class="fw-bold text-dark font-heading mb-3 pb-2 border-bottom">
                        Tóm Tắt Đơn Hàng (@CartState.TotalItemCount món)
                    </h5>

                    <!-- Item list -->
                    <div class="d-flex flex-column gap-3 mb-3 overflow-auto" style="max-height: 280px;">
                        @foreach (var item in CartState.Basket.Items)
                        {
                            <div class="d-flex align-items-center gap-3 pb-2 border-bottom">
                                <img src="@(string.IsNullOrEmpty(item.PictureUrl) ? "https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=100" : item.PictureUrl)" 
                                     alt="@item.ProductName" 
                                     class="rounded-3 border" 
                                     style="width: 54px; height: 54px; object-fit: contain;" />
                                <div class="flex-grow-1 small">
                                    <div class="fw-bold text-dark text-truncate" style="max-width: 180px;">@item.ProductName</div>
                                    <div class="text-muted">SL: @item.Quantity × @item.UnitPrice.ToString("N0") ₫</div>
                                </div>
                                <div class="fw-bold text-primary small">
                                    @((item.UnitPrice * item.Quantity).ToString("N0")) ₫
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Price calculation -->
                    <div class="d-flex flex-column gap-2 small text-secondary mb-3">
                        <div class="d-flex justify-content-between">
                            <span>Tạm tính:</span>
                            <span class="text-dark fw-semibold">@CartState.TotalAmount.ToString("N0") ₫</span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span>Phí vận chuyển:</span>
                            <span class="text-success fw-semibold">Miễn phí (Free Ship)</span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span>Thuế VAT (10%):</span>
                            <span>Đã bao gồm</span>
                        </div>
                        @if (_discountAmount > 0)
                        {
                            <div class="d-flex justify-content-between text-success fw-semibold">
                                <span>Mã giảm giá (@_appliedPromo):</span>
                                <span>-@_discountAmount.ToString("N0") ₫</span>
                            </div>
                        }

                        <!-- Promo Code Input -->
                        <div class="input-group input-group-sm mt-2 mb-1">
                            <input type="text" class="form-control" placeholder="Mã giảm giá (VD: ESHOP2026)" @bind="_promoCode" />
                            <button class="btn btn-outline-primary" type="button" @onclick="ApplyPromoCode">Áp dụng</button>
                        </div>
                        @if (!string.IsNullOrEmpty(_promoMessage))
                        {
                            <div class="small text-success">@_promoMessage</div>
                        }

                        <hr class="my-2" />
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="fw-bold text-dark fs-6">Tổng thanh toán:</span>
                            <span class="fs-4 fw-bold text-primary font-heading">
                                @((Math.Max(0, CartState.TotalAmount - _discountAmount)).ToString("N0")) ₫
                            </span>
                        </div>
                    </div>

                    <!-- Place Order Button -->
                    <button class="btn btn-brand w-100 rounded-pill py-3 fw-bold shadow-sm d-flex align-items-center justify-content-center gap-2"
                            disabled="@_isSubmitting"
                            @onclick="HandleSubmitOrderAsync">
                        @if (_isSubmitting)
                        {
                            <span class="spinner-border spinner-border-sm" role="status"></span>
                            <span>Đang khởi tạo đơn hàng...</span>
                        }
                        else if (_paymentMethod == "VNPay")
                        {
                            <i class="bi bi-shield-check fs-5"></i>
                            <span>Thanh Toán Qua VNPay</span>
                        }
                        else
                        {
                            <i class="bi bi-bag-check-fill fs-5"></i>
                            <span>Xác Nhận Đặt Hàng (COD)</span>
                        }
                    </button>

                    <div class="text-center text-muted small mt-3" style="font-size: 0.75rem;">
                        <i class="bi bi-lock-fill me-1 text-success"></i> Giao dịch bảo mật chuẩn SSL 256-bit
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<AuthModal @bind-IsOpen="_showAuthModal" />

@code {
    private bool _showAuthModal = false;
    private bool _isSubmitting = false;
    private string _errorMessage = "";
    private string _phoneNumber = "0988123456";
    private string _paymentMethod = "VNPay"; // Mặc định khuyến nghị VNPay

    private string _promoCode = "";
    private string _appliedPromo = "";
    private string _promoMessage = "";
    private decimal _discountAmount = 0m;

    private AddressDto _shippingAddress = new()
    {
        Street = "123 Nguyễn Huệ",
        District = "Quận 1",
        City = "TP. Hồ Chí Minh",
        ZipCode = "70000",
        Country = "Vietnam"
    };

    private void ApplyPromoCode()
    {
        if (string.IsNullOrWhiteSpace(_promoCode)) return;

        var code = _promoCode.Trim().ToUpperInvariant();
        if (code == "ESHOP2026")
        {
            _discountAmount = 500000m;
            _appliedPromo = "ESHOP2026 (-500.000₫)";
            _promoMessage = "✓ Đã áp dụng mã giảm giá thành công!";
            ToastService.ShowSuccess("Áp dụng mã giảm 500.000₫ thành công!");
        }
        else if (code == "GIAM100K")
        {
            _discountAmount = 100000m;
            _appliedPromo = "GIAM100K (-100.000₫)";
            _promoMessage = "✓ Đã áp dụng mã giảm giá 100.000₫!";
            ToastService.ShowSuccess("Áp dụng mã giảm 100.000₫ thành công!");
        }
        else
        {
            _promoMessage = "";
            ToastService.ShowWarning("Mã giảm giá không hợp lệ. Hãy thử ESHOP2026 hoặc GIAM100K.");
        }
    }

    protected override void OnInitialized()
    {
        CartState.OnChange += StateHasChanged;
        AuthState.OnChange += StateHasChanged;
    }

    private async Task HandleSubmitOrderAsync()
    {
        _errorMessage = "";

        if (string.IsNullOrWhiteSpace(_shippingAddress.Street) ||
            string.IsNullOrWhiteSpace(_shippingAddress.District) ||
            string.IsNullOrWhiteSpace(_shippingAddress.City))
        {
            _errorMessage = "Vui lòng nhập đầy đủ Số nhà/Tên đường, Quận/Huyện và Tỉnh/Thành phố.";
            return;
        }

        _isSubmitting = true;
        try
        {
            var order = await ApiClient.CreateOrderAsync(_shippingAddress, _paymentMethod);

            if (order != null)
            {
                ToastService.ShowSuccess($"Đơn hàng #{order.Id} đã được tạo thành công!", "Đặt hàng thành công");

                if (_paymentMethod == "VNPay" && !string.IsNullOrWhiteSpace(order.PaymentUrl))
                {
                    // Chuyển hướng trực tiếp sang cổng thanh toán VNPay Sandbox
                    Navigation.NavigateTo(order.PaymentUrl, forceLoad: true);
                }
                else
                {
                    // Đơn hàng COD -> Chuyển về danh sách đơn hàng
                    Navigation.NavigateTo($"orders?newOrder={order.Id}");
                }
            }
            else
            {
                _errorMessage = "Không thể tạo đơn hàng. Vui lòng kiểm tra lại tồn kho hoặc giỏ hàng.";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Lỗi xử lý: {ex.Message}";
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    public void Dispose()
    {
        CartState.OnChange -= StateHasChanged;
        AuthState.OnChange -= StateHasChanged;
    }
}
