@page "/product/{Id:int}"
@inject ShopApiClient ApiClient
@inject CartStateService CartState
@inject AuthStateService AuthState
@inject ComparisonStateService ComparisonState
@inject ToastService ToastService
@inject NavigationManager Navigation
@using eShop.Web.Services

<PageTitle>@(_product?.Name ?? "Chi tiết sản phẩm") • eShop Chính Hãng</PageTitle>

<div class="container py-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a href="" class="text-decoration-none text-secondary">Trang chủ</a></li>
            @if (_product != null)
            {
                <li class="breadcrumb-item active text-secondary" aria-current="page">@_product.CategoryName</li>
                <li class="breadcrumb-item active text-dark fw-semibold" aria-current="page">@_product.Name</li>
            }
        </ol>
    </nav>

    @if (_isLoading)
    {
        <div class="row g-5">
            <div class="col-lg-6">
                <div class="skeleton-box rounded-4" style="height: 450px; width: 100%;"></div>
            </div>
            <div class="col-lg-6">
                <div class="skeleton-box mb-3" style="height: 32px; width: 80%;"></div>
                <div class="skeleton-box mb-3" style="height: 24px; width: 40%;"></div>
                <div class="skeleton-box mb-4" style="height: 120px; width: 100%;"></div>
                <div class="skeleton-box" style="height: 48px; width: 50%;"></div>
            </div>
        </div>
    }
    else if (_product == null)
    {
        <div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-white my-4 mx-auto" style="max-width: 550px;">
            <div class="d-inline-flex p-4 rounded-circle mb-3 mx-auto text-muted" style="background: #f1f5f9; font-size: 3rem;">
                <i class="bi bi-exclamation-triangle"></i>
            </div>
            <h4 class="fw-bold text-dark mb-2">Không tìm thấy sản phẩm</h4>
            <p class="text-secondary small mb-4">
                Sản phẩm bạn đang tìm kiếm có thể đã ngừng kinh doanh hoặc đường dẫn không chính xác.
            </p>
            <div>
                <a href="" class="btn btn-primary rounded-pill px-4 py-2" style="background: var(--brand-gradient); border: none;">
                    <i class="bi bi-arrow-left me-1"></i> Quay Lại Cửa Hàng
                </a>
            </div>
        </div>
    }
    else
    {
        var specs = ProductSpecsProvider.GetSpecs(_product);
        var isComparing = ComparisonState.IsInComparison(_product.Id);

        <!-- Product Main Showcase -->
        <div class="row g-5 mb-5 align-items-center">
            <!-- Left: Product Image & Badges -->
            <div class="col-lg-6">
                <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white p-4 text-center position-relative">
                    <img src="@(string.IsNullOrEmpty(_product.PictureUrl) ? "https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=600" : _product.PictureUrl)" 
                         alt="@_product.Name" 
                         class="img-fluid rounded-3 mx-auto" 
                         style="max-height: 420px; object-fit: contain;" />

                    <div class="position-absolute top-0 start-0 m-3">
                        <span class="badge bg-dark bg-opacity-75 rounded-pill px-3 py-2 small">
                            Thương hiệu: @_product.BrandName
                        </span>
                    </div>

                    <div class="position-absolute top-0 end-0 m-3">
                        @if (_product.AvailableStock > 0)
                        {
                            <span class="badge bg-success rounded-pill px-3 py-2 small shadow-sm">
                                <i class="bi bi-check-circle-fill me-1"></i> Còn @_product.AvailableStock sản phẩm
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-danger rounded-pill px-3 py-2 small shadow-sm">
                                <i class="bi bi-x-circle-fill me-1"></i> Tạm hết hàng
                            </span>
                        }
                    </div>
                </div>
            </div>

            <!-- Right: Product Info & Actions -->
            <div class="col-lg-6">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <span class="badge bg-primary-subtle text-primary border border-primary border-opacity-25 rounded-pill px-3 py-1">
                        @_product.CategoryName
                    </span>
                    <span class="badge bg-light text-secondary border small">Mã SP: @_product.SKU</span>
                    <span class="badge bg-success-subtle text-success border border-success border-opacity-25 small">
                        <i class="bi bi-shield-check me-1"></i> 100% Chính Hãng
                    </span>
                </div>

                <h2 class="fw-bold text-dark font-heading mb-3" style="font-size: 2rem; line-height: 1.25;">
                    @_product.Name
                </h2>

                <!-- Rating & Reviews -->
                <div class="d-flex align-items-center gap-2 mb-3 small">
                    <div class="text-warning">
                        <i class="bi bi-star-fill"></i>
                        <i class="bi bi-star-fill"></i>
                        <i class="bi bi-star-fill"></i>
                        <i class="bi bi-star-fill"></i>
                        <i class="bi bi-star-half"></i>
                    </div>
                    <span class="fw-bold text-dark">4.9/5</span>
                    <span class="text-muted">• (128 đánh giá từ khách hàng)</span>
                </div>

                <!-- Price Box -->
                <div class="p-3 bg-light rounded-4 mb-4 border d-flex align-items-baseline gap-3">
                    <span class="display-6 fw-bold text-primary font-heading">
                        @_product.Price.ToString("N0") ₫
                    </span>
                    <span class="badge bg-danger rounded-pill px-2 py-1 small">-15% Giá Niêm Yết</span>
                    <span class="text-muted small ms-auto">Đã bao gồm thuế VAT</span>
                </div>

                <!-- Description Snippet -->
                <div class="mb-4 text-secondary leading-relaxed" style="font-size: 0.95rem;">
                    <p>@(string.IsNullOrWhiteSpace(_product.Description) ? "Sản phẩm công nghệ chính hãng, phân phối bởi hệ thống siêu thị eShop Việt Nam." : _product.Description)</p>
                </div>

                <!-- Quantity Selector & Actions -->
                @if (_product.AvailableStock > 0)
                {
                    <div class="mb-4">
                        <label class="form-label small fw-semibold text-dark mb-2">Số lượng đặt mua:</label>
                        <div class="d-flex align-items-center gap-3">
                            <div class="input-group" style="width: 140px;">
                                <button class="btn btn-outline-secondary" type="button" @onclick="DecreaseQuantity" disabled="@(_quantity <= 1)">
                                    <i class="bi bi-dash"></i>
                                </button>
                                <input type="text" class="form-control text-center fw-bold" readonly value="@_quantity" />
                                <button class="btn btn-outline-secondary" type="button" @onclick="IncreaseQuantity" disabled="@(_quantity >= _product.AvailableStock)">
                                    <i class="bi bi-plus"></i>
                                </button>
                            </div>
                            <span class="text-success small fw-medium">
                                <i class="bi bi-boxes me-1"></i> Có sẵn @_product.AvailableStock sản phẩm sẵn sàng giao
                            </span>
                        </div>
                    </div>

                    <div class="d-flex flex-wrap gap-2 mb-4">
                        <button class="btn btn-outline-primary rounded-pill px-4 py-3 fw-bold flex-grow-1 shadow-sm d-flex align-items-center justify-content-center gap-2"
                                disabled="@_isAdding"
                                @onclick="AddToCartAsync">
                            @if (_isAdding)
                            {
                                <span class="spinner-border spinner-border-sm" role="status"></span>
                                <span>Đang thêm...</span>
                            }
                            else
                            {
                                <i class="bi bi-cart-plus-fill fs-5"></i>
                                <span>Thêm Vào Giỏ Hàng</span>
                            }
                        </button>

                        <button class="btn btn-primary rounded-pill px-4 py-3 fw-bold flex-grow-1 shadow-sm d-flex align-items-center justify-content-center gap-2"
                                style="background: var(--brand-gradient); border: none;"
                                disabled="@_isAdding"
                                @onclick="BuyNowAsync">
                            <i class="bi bi-lightning-charge-fill text-warning fs-5"></i>
                            <span>Mua Ngay</span>
                        </button>

                        <button class="btn @(isComparing ? "btn-warning text-dark" : "btn-outline-secondary") rounded-pill px-3 py-3 fw-semibold shadow-sm d-flex align-items-center justify-content-center gap-1"
                                title="So sánh thông số với sản phẩm khác"
                                @onclick="ToggleComparison">
                            <i class="bi @(isComparing ? "bi-check-lg" : "bi-arrow-left-right")"></i>
                            <span>@(isComparing ? "Đang so sánh" : "So sánh")</span>
                        </button>
                    </div>
                }
                else
                {
                    <div class="alert alert-danger rounded-4 p-3 mb-4 d-flex align-items-center gap-2">
                        <i class="bi bi-x-circle-fill fs-4"></i>
                        <div>Sản phẩm hiện đang tạm hết hàng trong kho. Vui lòng quay lại sau hoặc liên hệ Hotline 1800.6868!</div>
                    </div>
                }

                <!-- Trust Badges -->
                <div class="row g-2 pt-3 border-top text-secondary small">
                    <div class="col-6 d-flex align-items-center gap-2">
                        <i class="bi bi-shield-check text-success fs-5"></i>
                        <span>Bảo hành chính hãng 12 tháng</span>
                    </div>
                    <div class="col-6 d-flex align-items-center gap-2">
                        <i class="bi bi-truck text-primary fs-5"></i>
                        <span>Giao hàng hỏa tốc trong 2 giờ</span>
                    </div>
                    <div class="col-6 d-flex align-items-center gap-2">
                        <i class="bi bi-arrow-repeat text-warning fs-5"></i>
                        <span>1 đổi 1 trong 30 ngày nếu lỗi</span>
                    </div>
                    <div class="col-6 d-flex align-items-center gap-2">
                        <i class="bi bi-credit-card text-info fs-5"></i>
                        <span>Hỗ trợ VNPay-QR & Trả góp 0%</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- 2. Detailed Technical Specifications Table -->
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-5 bg-white">
            <div class="card-header bg-dark text-white p-3 px-4 d-flex align-items-center gap-2">
                <i class="bi bi-cpu-fill text-warning fs-5"></i>
                <h5 class="mb-0 fw-bold font-heading">Thông Số Kỹ Thuật Chi Tiết</h5>
            </div>
            <div class="card-body p-0">
                <table class="table table-striped table-hover mb-0 align-middle">
                    <tbody>
                        <tr>
                            <td class="fw-semibold text-muted px-4" style="width: 25%;"><i class="bi bi-display me-2 text-primary"></i> Màn hình</td>
                            <td class="px-4 text-dark fw-medium">@specs.Screen</td>
                        </tr>
                        <tr>
                            <td class="fw-semibold text-muted px-4"><i class="bi bi-cpu me-2 text-danger"></i> Vi xử lý (CPU/Chip)</td>
                            <td class="px-4 text-primary fw-bold">@specs.Cpu</td>
                        </tr>
                        <tr>
                            <td class="fw-semibold text-muted px-4"><i class="bi bi-memory me-2 text-success"></i> Dung lượng RAM</td>
                            <td class="px-4 text-dark fw-bold">@specs.Ram</td>
                        </tr>
                        <tr>
                            <td class="fw-semibold text-muted px-4"><i class="bi bi-hdd me-2 text-info"></i> Bộ nhớ trong (ROM/SSD)</td>
                            <td class="px-4 text-dark fw-bold">@specs.Storage</td>
                        </tr>
                        <tr>
                            <td class="fw-semibold text-muted px-4"><i class="bi bi-camera me-2 text-warning"></i> Hệ thống Camera</td>
                            <td class="px-4 text-dark">@specs.Camera</td>
                        </tr>
                        <tr>
                            <td class="fw-semibold text-muted px-4"><i class="bi bi-battery-charging me-2 text-success"></i> Dung lượng Pin & Sạc</td>
                            <td class="px-4 text-dark">@specs.Battery</td>
                        </tr>
                        <tr>
                            <td class="fw-semibold text-muted px-4"><i class="bi bi-feather me-2 text-secondary"></i> Trọng lượng & Thiết kế</td>
                            <td class="px-4 text-dark">@specs.Weight</td>
                        </tr>
                        <tr>
                            <td class="fw-semibold text-muted px-4"><i class="bi bi-windows me-2 text-primary"></i> Hệ điều hành tương thích</td>
                            <td class="px-4 text-dark">@specs.Os</td>
                        </tr>
                        <tr>
                            <td class="fw-semibold text-muted px-4"><i class="bi bi-patch-check-fill me-2 text-success"></i> Tiêu chuẩn bảo hành</td>
                            <td class="px-4 text-success fw-bold">
                                <i class="bi bi-check-circle-fill me-1"></i> @specs.Warranty
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- 3. Related Products Section -->
        @if (_relatedProducts != null && _relatedProducts.Any())
        {
            <div class="mt-5 pt-4 border-top">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h3 class="fw-bold font-heading mb-0">Sản Phẩm Cùng Ngành Hàng</h3>
                    <a href="" class="text-decoration-none small fw-semibold text-primary">Xem tất cả <i class="bi bi-arrow-right"></i></a>
                </div>

                <div class="row g-4">
                    @foreach (var item in _relatedProducts.Take(4))
                    {
                        <div class="col-lg-3 col-md-6">
                            <div class="product-card h-100 d-flex flex-column">
                                <div class="product-image-container">
                                    <a href="product/@item.Id">
                                        <img src="@(string.IsNullOrEmpty(item.PictureUrl) ? "https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=400" : item.PictureUrl)" 
                                             alt="@item.Name" loading="lazy" />
                                    </a>
                                </div>
                                <div class="p-3 d-flex flex-column flex-grow-1">
                                    <div class="small text-muted mb-1">@item.BrandName</div>
                                    <h6 class="fw-bold mb-2 text-truncate" title="@item.Name">
                                        <a href="product/@item.Id" class="text-dark text-decoration-none">@item.Name</a>
                                    </h6>
                                    <div class="product-price fs-6 mb-3">@item.Price.ToString("N0") ₫</div>
                                    <a href="product/@item.Id" class="btn btn-outline-primary btn-sm rounded-pill mt-auto w-100">
                                        Xem Chi Tiết
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    }
</div>

@code {
    [Parameter]
    public int Id { get; set; }

    private ProductDto? _product;
    private List<ProductDto>? _relatedProducts;
    private bool _isLoading = true;
    private bool _isAdding = false;
    private int _quantity = 1;

    protected override async Task OnParametersSetAsync()
    {
        await LoadProductDetailAsync();
    }

    private async Task LoadProductDetailAsync()
    {
        _isLoading = true;
        _quantity = 1;
        try
        {
            _product = await ApiClient.GetProductByIdAsync(Id);

            if (_product != null)
            {
                var relatedRes = await ApiClient.GetProductsAsync(pageIndex: 1, pageSize: 8, categoryId: _product.CategoryId);
                _relatedProducts = relatedRes?.Items.Where(p => p.Id != Id).ToList();
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Không thể tải thông tin sản phẩm: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void IncreaseQuantity()
    {
        if (_product != null && _quantity < _product.AvailableStock)
        {
            _quantity++;
        }
    }

    private void DecreaseQuantity()
    {
        if (_quantity > 1)
        {
            _quantity--;
        }
    }

    private void ToggleComparison()
    {
        if (_product == null) return;

        if (ComparisonState.IsInComparison(_product.Id))
        {
            ComparisonState.RemoveProduct(_product.Id);
            ToastService.ShowInfo($"Đã bỏ {_product.Name} khỏi danh sách so sánh.");
        }
        else
        {
            if (ComparisonState.AddProduct(_product, out var msg))
            {
                ToastService.ShowSuccess(msg, "So sánh thông số");
            }
            else
            {
                ToastService.ShowWarning(msg);
            }
        }
    }

    private async Task AddToCartAsync()
    {
        if (!AuthState.IsAuthenticated)
        {
            ToastService.ShowWarning("Vui lòng đăng nhập tài khoản để thêm vào giỏ hàng.", "Yêu cầu đăng nhập");
            return;
        }

        if (_product == null) return;

        _isAdding = true;
        try
        {
            var buyerId = AuthState.CurrentBuyerId;
            var updatedBasket = await ApiClient.AddItemToBasketAsync(buyerId, _product.Id, _quantity);

            if (updatedBasket != null)
            {
                ToastService.ShowSuccess($"Đã thêm {_quantity}x {_product.Name} vào giỏ hàng!", "Giỏ hàng");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Không thể thêm vào giỏ: {ex.Message}");
        }
        finally
        {
            _isAdding = false;
        }
    }

    private async Task BuyNowAsync()
    {
        await AddToCartAsync();
        if (AuthState.IsAuthenticated)
        {
            Navigation.NavigateTo("checkout");
        }
    }
}
