@using eShop.Application.Catalog.DTOs
@using eShop.Web.Services
@inject ComparisonStateService ComparisonState
@implements IDisposable

@if (ComparisonState.Count > 0)
{
    <div class="comparison-dock shadow-lg">
        <div class="container d-flex align-items-center justify-content-between py-2 flex-wrap gap-2">
            <!-- Left: Title & Count -->
            <div class="d-flex align-items-center gap-2">
                <span class="badge rounded-pill bg-primary px-3 py-2 fw-bold">
                    <i class="bi bi-arrow-left-right me-1"></i> So sánh (@ComparisonState.Count/3)
                </span>
                <span class="text-white small d-none d-md-inline">Chọn tối đa 3 sản phẩm để xem bảng đối chiếu</span>
            </div>

            <!-- Middle: Selected Product Chips -->
            <div class="d-flex align-items-center gap-2 flex-wrap">
                @foreach (var prod in ComparisonState.ComparisonProducts)
                {
                    <div class="d-flex align-items-center gap-2 bg-dark bg-opacity-75 text-white px-2 py-1 rounded-pill border border-secondary border-opacity-50">
                        <img src="@(string.IsNullOrEmpty(prod.PictureUrl) ? "https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=60" : prod.PictureUrl)" 
                             alt="@prod.Name" class="rounded-circle" style="width: 24px; height: 24px; object-fit: cover;" />
                        <span class="small text-truncate fw-medium" style="max-width: 140px;" title="@prod.Name">@prod.Name</span>
                        <button class="btn btn-sm text-secondary hover-text-white p-0 border-0" 
                                title="Xóa món này" 
                                @onclick="() => ComparisonState.RemoveProduct(prod.Id)">
                            <i class="bi bi-x-circle-fill text-danger"></i>
                        </button>
                    </div>
                }
            </div>

            <!-- Right: Action Buttons -->
            <div class="d-flex align-items-center gap-2">
                <button class="btn btn-sm btn-outline-light rounded-pill px-3" @onclick="ComparisonState.Clear">
                    Xóa tất cả
                </button>
                <button class="btn btn-sm btn-warning text-dark fw-bold rounded-pill px-4 shadow-sm" @onclick="OpenModal">
                    <i class="bi bi-binoculars-fill me-1"></i> So sánh ngay
                </button>
            </div>
        </div>
    </div>
}

<ComparisonModal @bind-IsOpen="_showModal" />

@code {
    private bool _showModal = false;

    protected override void OnInitialized()
    {
        ComparisonState.OnChange += StateHasChanged;
    }

    private void OpenModal()
    {
        _showModal = true;
    }

    public void Dispose()
    {
        ComparisonState.OnChange -= StateHasChanged;
    }
}
