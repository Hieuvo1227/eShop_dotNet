@inject ShopApiClient ApiClient
@inject CartStateService CartState
@inject AuthStateService AuthState
@inject ToastService ToastService

<!-- Floating Trigger Button -->
@if (!_isOpen)
{
    <button class="ai-copilot-trigger" @onclick="ToggleOpen" title="Trò chuyện cùng Trợ lý AI eShop">
        <i class="bi bi-robot"></i>
        <span class="position-absolute top-0 start-100 translate-middle p-1 bg-success border border-light rounded-circle">
            <span class="visually-hidden">AI sẵn sàng</span>
        </span>
    </button>
}
else
{
    <!-- Floating Chat Window (Glassmorphic & Rounded XL) -->
    <div class="ai-chat-window shadow-lg">
        <!-- Window Header -->
        <div class="p-3 d-flex align-items-center justify-content-between text-white" 
             style="background: #0f172a; border-bottom: 1px solid rgba(255,255,255,0.08);">
            <div class="d-flex align-items-center gap-2">
                <div class="rounded-circle d-flex align-items-center justify-content-center text-white" 
                     style="width: 38px; height: 38px; background: var(--brand-gradient); font-size: 1.2rem;">
                    <i class="bi bi-robot"></i>
                </div>
                <div>
                    <div class="fw-bold fs-6 mb-0">Trợ Lý Tư Vấn eShop AI</div>
                    <div class="d-flex align-items-center gap-1" style="font-size: 0.72rem; color: #94a3b8;">
                        <span class="rounded-circle bg-success d-inline-block" style="width: 7px; height: 7px;"></span>
                        <span>Tư vấn cấu hình máy & Kiểm tra kho 24/7</span>
                    </div>
                </div>
            </div>

            <div class="d-flex align-items-center gap-1">
                <button type="button" class="btn btn-sm text-secondary p-1" title="Xóa lịch sử chat" @onclick="ClearChat">
                    <i class="bi bi-trash3"></i>
                </button>
                <button type="button" class="btn btn-sm text-white p-1" @onclick="ToggleOpen" title="Đóng cửa sổ">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
        </div>

        <!-- Chat Messages Area -->
        <div class="flex-grow-1 p-3 overflow-auto d-flex flex-column gap-3" id="ai-chat-messages" style="background: #f8fafc;">
            @foreach (var msg in _messages)
            {
                <div class="d-flex @(msg.Role == "user" ? "justify-content-end" : "justify-content-start")">
                    @if (msg.Role != "user")
                    {
                        <div class="rounded-circle d-flex align-items-center justify-content-center text-primary me-2 flex-shrink-0"
                             style="width: 28px; height: 28px; background: rgba(37, 99, 235, 0.1); font-size: 0.85rem;">
                            <i class="bi bi-robot"></i>
                        </div>
                    }

                    <div class="p-3 rounded-4 shadow-sm" 
                         style="max-width: 82%; font-size: 0.9rem; @(msg.Role == "user" ? "background: var(--brand-gradient); color: white; border-bottom-right-radius: 4px !important;" : "background: #ffffff; color: #1e293b; border: 1px solid #e2e8f0; border-bottom-left-radius: 4px !important;")">
                        
                        <div style="white-space: pre-wrap; line-height: 1.45;">@msg.Content</div>

                        @if (msg.SuggestedProducts?.Any() == true)
                        {
                            <div class="mt-2 pt-2 border-top border-light-subtle">
                                <div class="small fw-bold text-success mb-2">
                                    <i class="bi bi-stars"></i> Gợi ý thiết bị phù hợp:
                                </div>
                                <div class="d-flex flex-column gap-2">
                                    @foreach (var prod in msg.SuggestedProducts)
                                    {
                                        <div class="card p-2 bg-light border-0 shadow-none text-dark d-flex flex-row align-items-center gap-2 rounded-3">
                                            <img src="@(string.IsNullOrEmpty(prod.PictureUrl) ? "https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=100" : prod.PictureUrl)" 
                                                 alt="@prod.Name" class="rounded-2" style="width: 44px; height: 44px; object-fit: cover;" />
                                            <div class="flex-grow-1 overflow-hidden">
                                                <div class="fw-bold text-truncate small" title="@prod.Name">@prod.Name</div>
                                                <div class="text-primary fw-bold" style="font-size: 0.8rem;">@prod.Price.ToString("N0") ₫</div>
                                            </div>
                                            <button class="btn btn-sm btn-primary rounded-pill px-2 py-1 small" 
                                                    title="Thêm vào giỏ"
                                                    @onclick="() => AddToCartFromAi(prod.Id, prod.Name)">
                                                <i class="bi bi-cart-plus"></i>
                                            </button>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }

            @if (_isThinking)
            {
                <div class="d-flex align-items-center gap-2 text-muted small ps-2">
                    <div class="spinner-grow spinner-grow-sm text-primary" role="status"></div>
                    <span class="fst-italic">AI đang phân tích và tìm kiếm sản phẩm phù hợp trong kho...</span>
                </div>
            }
        </div>

        <!-- Suggestion Prompt Pills -->
        @if (_messages.Count <= 2 && !_isThinking)
        {
            <div class="p-2 border-top bg-white overflow-auto d-flex gap-2">
                <button class="btn btn-sm btn-light border rounded-pill px-3 py-1 text-nowrap small text-muted" 
                        @onclick='() => SendPromptAsync("Tìm iPhone dưới 30 triệu")'>
                    🔍 iPhone dưới 30 triệu
                </button>
                <button class="btn btn-sm btn-light border rounded-pill px-3 py-1 text-nowrap small text-muted" 
                        @onclick='() => SendPromptAsync("Laptop cho sinh viên đồ họa")'>
                    💻 Laptop đồ họa
                </button>
                <button class="btn btn-sm btn-light border rounded-pill px-3 py-1 text-nowrap small text-muted" 
                        @onclick='() => SendPromptAsync("Tai nghe Sony chống ồn cao cấp")'>
                    🎧 Tai nghe chống ồn
                </button>
            </div>
        }

        <!-- Input Form Area -->
        <div class="p-3 bg-white border-top">
            <form @onsubmit="SendMessageAsync" class="d-flex gap-2">
                <input type="text" class="form-control rounded-pill px-3 py-2 small border-1" 
                       placeholder="Hỏi AI về điện thoại, laptop, phụ kiện..." 
                       @bind="_inputMessage" 
                       disabled="@_isThinking" />
                <button type="submit" class="btn btn-primary rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" 
                        style="width: 42px; height: 42px; background: var(--brand-gradient); border: none;" 
                        disabled="@(string.IsNullOrWhiteSpace(_inputMessage) || _isThinking)">
                    <i class="bi bi-send-fill"></i>
                </button>
            </form>
        </div>
    </div>
}

@code {
    private bool _isOpen = false;
    private bool _isThinking = false;
    private string _inputMessage = "";

    private class LocalMessage
    {
        public string Role { get; set; } = "user";
        public string Content { get; set; } = "";
        public List<ProductDto>? SuggestedProducts { get; set; }
    }

    private readonly List<LocalMessage> _messages = new()
    {
        new LocalMessage
        {
            Role = "assistant",
            Content = "👋 Xin chào! Tôi là Trợ lý AI eShop. Tôi có thể hỗ trợ bạn tìm kiếm thiết bị công nghệ phù hợp với ngân sách, so sánh thông số kỹ thuật và kiểm tra sản phẩm còn hàng. Bạn đang cần tư vấn dòng sản phẩm nào?"
        }
    };

    private void ToggleOpen()
    {
        _isOpen = !_isOpen;
        StateHasChanged();
    }

    private void ClearChat()
    {
        _messages.Clear();
        _messages.Add(new LocalMessage
        {
            Role = "assistant",
            Content = "Lịch sử trò chuyện đã được làm mới. Hãy nhập yêu cầu của bạn!"
        });
        StateHasChanged();
    }

    private async Task SendPromptAsync(string prompt)
    {
        _inputMessage = prompt;
        await SendMessageAsync();
    }

    private async Task SendMessageAsync()
    {
        if (string.IsNullOrWhiteSpace(_inputMessage) || _isThinking) return;

        var userText = _inputMessage.Trim();
        _inputMessage = "";

        if (!AuthState.IsAuthenticated)
        {
            _messages.Add(new LocalMessage
            {
                Role = "user",
                Content = userText
            });
            _messages.Add(new LocalMessage
            {
                Role = "assistant",
                Content = "Chào bạn! Để sử dụng Trợ lý AI và nhận gợi ý sản phẩm cá nhân hóa, vui lòng Đăng nhập tài khoản trước nhé (bạn có thể bấm nút Đăng Nhập nhanh trên thanh menu)."
            });
            ToastService.ShowWarning("Vui lòng đăng nhập tài khoản để sử dụng Trợ lý AI.");
            StateHasChanged();
            return;
        }

        _messages.Add(new LocalMessage
        {
            Role = "user",
            Content = userText
        });

        _isThinking = true;
        StateHasChanged();

        try
        {
            var history = _messages
                .Where(m => m.Role == "user" || m.Role == "assistant")
                .Select(m => new ChatMessageDto(m.Role, m.Content))
                .ToList();

            var response = await ApiClient.ChatWithAiAsync(userText, history);

            _messages.Add(new LocalMessage
            {
                Role = "assistant",
                Content = response?.Message ?? "Không nhận được phản hồi từ AI Assistant.",
                SuggestedProducts = response?.SuggestedProducts
            });
        }
        catch (Exception ex)
        {
            _messages.Add(new LocalMessage
            {
                Role = "assistant",
                Content = $"Hệ thống đang bận: {ex.Message}. Vui lòng thử lại sau giây lát!"
            });
        }
        finally
        {
            _isThinking = false;
            StateHasChanged();
        }
    }

    private async Task AddToCartFromAi(int productId, string productName)
    {
        try
        {
            await ApiClient.AddItemToBasketAsync(AuthState.CurrentBuyerId, productId, 1);
            ToastService.ShowSuccess($"Đã thêm {productName} vào giỏ hàng!", "Thành công");
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Không thể thêm vào giỏ: {ex.Message}");
        }
    }
}
