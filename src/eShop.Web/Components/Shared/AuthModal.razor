@inject ShopApiClient ApiClient
@inject AuthStateService AuthState
@inject ToastService ToastService

@if (IsOpen)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(15, 23, 42, 0.6); backdrop-filter: blur(8px);">
        <div class="modal-dialog modal-dialog-centered" style="max-width: 440px;">
            <div class="modal-content border-0 rounded-4 shadow-lg overflow-hidden">
                <div class="modal-header border-0 pb-0 pt-4 px-4 position-relative">
                    <button type="button" class="btn-close position-absolute top-0 end-0 m-3" @onclick="CloseModal"></button>
                    <div class="w-100 text-center">
                        <div class="d-inline-flex p-3 rounded-circle mb-2" style="background: rgba(37, 99, 235, 0.1); color: var(--brand-primary);">
                            <i class="bi bi-person-circle fs-2"></i>
                        </div>
                        <h4 class="fw-bold mb-1">Tài Khoản eShop</h4>
                        <p class="text-muted small mb-3">Đăng nhập để theo dõi đơn hàng và nhận ưu đãi độc quyền</p>

                        <!-- Tab switcher -->
                        <div class="btn-group w-100 p-1 rounded-pill" style="background: #f1f5f9;">
                            <button class="btn btn-sm rounded-pill fw-semibold @(_isLoginTab ? "btn-white shadow-sm" : "text-muted")"
                                    @onclick="() => _isLoginTab = true">
                                Đăng Nhập
                            </button>
                            <button class="btn btn-sm rounded-pill fw-semibold @(!_isLoginTab ? "btn-white shadow-sm" : "text-muted")"
                                    @onclick="() => _isLoginTab = false">
                                Đăng Ký
                            </button>
                        </div>
                    </div>
                </div>

                <div class="modal-body p-4">
                    @if (!string.IsNullOrEmpty(_errorMessage))
                    {
                        <div class="alert alert-danger py-2 small d-flex align-items-center gap-2 mb-3 rounded-3">
                            <i class="bi bi-exclamation-circle-fill"></i>
                            <div>@_errorMessage</div>
                        </div>
                    }

                    @if (_isLoginTab)
                    {
                        <!-- Quick Login Demo Buttons -->
                        <div class="mb-3 p-3 rounded-3 border" style="background: #f8fafc;">
                            <div class="small fw-bold text-dark mb-2">⚡ Chọn nhanh tài khoản thử nghiệm:</div>
                            <div class="d-flex gap-2">
                                <button class="btn btn-sm btn-outline-primary flex-fill rounded-pill" 
                                        @onclick='() => QuickFill("admin@eshop.com", "Admin@123")'
                                        disabled="@_isLoading">
                                    <i class="bi bi-shield-fill-check me-1"></i> Admin
                                </button>
                                <button class="btn btn-sm btn-outline-secondary flex-fill rounded-pill" 
                                        @onclick='() => QuickFill("user@eshop.com", "User@123")'
                                        disabled="@_isLoading">
                                    <i class="bi bi-person-fill me-1"></i> Khách hàng
                                </button>
                            </div>
                        </div>

                        <form @onsubmit="HandleLoginAsync">
                            <div class="mb-3">
                                <label class="form-label small fw-semibold">Email</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-envelope"></i></span>
                                    <input type="email" class="form-control border-start-0" placeholder="name@eshop.com" 
                                           @bind="_email" required />
                                </div>
                            </div>

                            <div class="mb-4">
                                <label class="form-label small fw-semibold">Mật khẩu</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-key"></i></span>
                                    <input type="password" class="form-control border-start-0" placeholder="••••••••" 
                                           @bind="_password" required />
                                </div>
                            </div>

                            <button type="submit" class="btn btn-brand w-100 py-2 rounded-3 shadow-sm" disabled="@_isLoading">
                                @if (_isLoading)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                    <span>Đang xác thực...</span>
                                }
                                else
                                {
                                    <span>Đăng Nhập Ngay</span>
                                }
                            </button>
                        </form>
                    }
                    else
                    {
                        <!-- Register Tab -->
                        <form @onsubmit="HandleRegisterAsync">
                            <div class="mb-3">
                                <label class="form-label small fw-semibold">Họ và tên</label>
                                <input type="text" class="form-control" placeholder="Nguyễn Văn A" 
                                       @bind="_fullName" required />
                            </div>

                            <div class="mb-3">
                                <label class="form-label small fw-semibold">Email</label>
                                <input type="email" class="form-control" placeholder="email@domain.com" 
                                       @bind="_email" required />
                            </div>

                            <div class="mb-4">
                                <label class="form-label small fw-semibold">Mật khẩu (ít nhất 6 ký tự)</label>
                                <input type="password" class="form-control" placeholder="••••••••" 
                                       @bind="_password" required minlength="6" />
                            </div>

                            <button type="submit" class="btn btn-brand w-100 py-2 rounded-3 shadow-sm" disabled="@_isLoading">
                                @if (_isLoading)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                    <span>Đang tạo tài khoản...</span>
                                }
                                else
                                {
                                    <span>Hoàn Tất Đăng Ký</span>
                                }
                            </button>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }

    private bool _isLoginTab = true;
    private string _email = "";
    private string _password = "";
    private string _fullName = "";
    private string _errorMessage = "";
    private bool _isLoading = false;

    private void QuickFill(string email, string password)
    {
        _email = email;
        _password = password;
        _errorMessage = "";
    }

    private async Task HandleLoginAsync()
    {
        _isLoading = true;
        _errorMessage = "";

        try
        {
            var result = await ApiClient.LoginAsync(_email, _password);
            if (result != null)
            {
                AuthState.SetUser(result);
                ToastService.ShowSuccess($"Đăng nhập thành công! Vai trò: {result.Role}", $"Xin chào {result.FullName}");
                await CloseModal();
            }
            else
            {
                _errorMessage = "Email hoặc mật khẩu không chính xác.";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Lỗi kết nối máy chủ: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task HandleRegisterAsync()
    {
        _isLoading = true;
        _errorMessage = "";

        try
        {
            var result = await ApiClient.RegisterAsync(_email, _password, _fullName);
            if (result != null)
            {
                AuthState.SetUser(result);
                ToastService.ShowSuccess("Tài khoản đã được khởi tạo thành công!", "Đăng ký thành công");
                await CloseModal();
            }
            else
            {
                _errorMessage = "Không thể đăng ký tài khoản. Vui lòng kiểm tra lại.";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Đăng ký thất bại: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task CloseModal()
    {
        IsOpen = false;
        _errorMessage = "";
        await IsOpenChanged.InvokeAsync(false);
    }
}

